// redrob_setup.rc -- resources for the Redrob Browser branded setup.
//
// The payload (mini_installer.exe) and the pre-rendered PNGs are injected by
// build.py, which writes the file paths into the macros below before invoking
// rc. A demo build may define REDROB_NO_PAYLOAD to omit the payload resource.

#include <windows.h>
#include "resource.h"
#include "build_defs.h"

// ---- icon ------------------------------------------------------------------
#ifdef REDROB_ICON_PATH
IDI_APPICON ICON REDROB_ICON_PATH
#endif

// ---- manifest (per-monitor-v2 DPI, common controls v6) ---------------------
IDR_MANIFEST RT_MANIFEST "redrob_setup.manifest"

// ---- RCDATA ----------------------------------------------------------------
#ifndef REDROB_NO_PAYLOAD
IDR_PAYLOAD        RCDATA REDROB_PAYLOAD_PATH
#endif
IDR_BACKGROUND_PNG RCDATA REDROB_BACKGROUND_PATH
IDR_LOCKUP_PNG     RCDATA REDROB_LOCKUP_PATH
#ifdef REDROB_FONT_PATH
IDR_FONT_SANS      RCDATA REDROB_FONT_PATH
#endif

// ---- VERSIONINFO -----------------------------------------------------------
#ifndef REDROB_VER_FILE
#define REDROB_VER_FILE 0,0,0,0
#endif
#ifndef REDROB_VER_STR
#define REDROB_VER_STR "0.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    REDROB_VER_FILE
 PRODUCTVERSION REDROB_VER_FILE
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Redrob"
            VALUE "FileDescription",  "Redrob Browser Setup"
            VALUE "FileVersion",      REDROB_VER_STR
            VALUE "InternalName",     "redrob_setup"
            VALUE "OriginalFilename", "redrob_setup.exe"
            VALUE "ProductName",      "Redrob Browser"
            VALUE "ProductVersion",   REDROB_VER_STR
            VALUE "LegalCopyright",   "Redrob"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
