# sources/manifest — code this fork owns outright, and where it goes in the checkout.
#
# `patches/README.md` is explicit that a file we add is not a patch, so these are copied into
# chromium/src by `./scripts/redrob.py apply` rather than diffed. They are also excluded from
# `export`'s "untracked files, move them into this repo" report, because they already are in it.
#
# Every path under sources/ mirrors its destination, so the mapping is checkable by eye.
#
# Format: SOURCE  TARGET

# The sidecar transport. Browser-process only: it launches the local Redrob Code engine on loopback,
# holds its generated credentials and never hands either to a renderer. See docs/AI_SURFACE.md.
sources/chrome/browser/redrob/BUILD.gn            chrome/browser/redrob/BUILD.gn
sources/chrome/browser/redrob/sidecar_client.h    chrome/browser/redrob/sidecar_client.h
sources/chrome/browser/redrob/sidecar_client.cc   chrome/browser/redrob/sidecar_client.cc

# chrome://redrob, the AI surface, and the Mojo boundary in front of it. The only Chromium files this
# needs are the one-line registrations in patches/, which is the whole point of a WebUI.
sources/chrome/browser/ui/webui/redrob/BUILD.gn          chrome/browser/ui/webui/redrob/BUILD.gn
sources/chrome/browser/ui/webui/redrob/redrob.mojom      chrome/browser/ui/webui/redrob/redrob.mojom
sources/chrome/browser/ui/webui/redrob/redrob_ui.h       chrome/browser/ui/webui/redrob/redrob_ui.h
sources/chrome/browser/ui/webui/redrob/redrob_ui.cc      chrome/browser/ui/webui/redrob/redrob_ui.cc
sources/chrome/browser/ui/webui/redrob/task_host_impl.h  chrome/browser/ui/webui/redrob/task_host_impl.h
sources/chrome/browser/ui/webui/redrob/task_host_impl.cc chrome/browser/ui/webui/redrob/task_host_impl.cc

# The page itself: a build_webui() target, so the TypeScript build and the generated Mojo bindings
# come with it. This is what replaced the scaffold's string literals.
sources/chrome/browser/resources/redrob/BUILD.gn    chrome/browser/resources/redrob/BUILD.gn
sources/chrome/browser/resources/redrob/redrob.html chrome/browser/resources/redrob/redrob.html
sources/chrome/browser/resources/redrob/redrob.css  chrome/browser/resources/redrob/redrob.css
sources/chrome/browser/resources/redrob/redrob.ts   chrome/browser/resources/redrob/redrob.ts
