// The <code>chrome.redrobPrivate</code> API is the single, component-gated
// bridge by which Redrob's own bundled extensions reach browser capability
// that a Web-facing extension API does not expose. It is restricted to
// component extensions in _permission_features.json; an ordinary extension
// cannot hold the permission, so this is the ONE crossing point the ownership
// boundary (docs/OWNERSHIP.md) allows.
//
// getBrowserVersion is deliberately the smallest possible method: it proves an
// extension can call into native through the fork-restricted permission, which
// is all the foundation item F-1 has to establish. The real surfaces
// (browser preferences, the omnibox agent) are added here as their WebUI
// migrates in later phases, each as one more function on this interface.
namespace redrobPrivate {
  callback GetBrowserVersionCallback = void (DOMString version);
  callback BoolCallback = void (boolean ok);
  // Resolves with a string when there is one, and with nothing when the
  // operation has no result to report — an absent value is not an empty one.
  callback StringCallback = void (optional DOMString value);

  // A browser found on this machine that onboarding could import from. Mirrors
  // the onboarding ImportSource mojom struct: each capability flag is read from
  // the source's own bitmask, because what one browser hands over is not what
  // another can.
  dictionary ImportSource {
    // What to call it in the UI, e.g. "Google Chrome".
    DOMString name;
    boolean hasBookmarks;
    boolean hasHistory;
    boolean hasPasswords;
    boolean hasSearchEngines;
    // Always false today: upstream defines the bit but nothing implements it.
    boolean hasCookies;
  };

  callback GetImportSourcesCallback = void (ImportSource[] sources);

  // How an import is going. Matches the onboarding ImportState mojom enum.
  enum ImportState {
    // The source browser is running and holds its data open. Recoverable: the
    // user closes it and retries, which is why it is its own state.
    idle,
    running,
    succeeded,
    sourceBusy,
    failed
  };

  // Mirrors of the settings mojom structs, so GetSettings can return the whole
  // AgentSettings tree over the private API. Enums are string enums (idl
  // convention); the mojom's kFoo values become "foo".
  enum PermissionMode { readOnly, guard, fullAccess };
  enum Effort { quick, standard, ultrabrowse };
  enum RoutineKind { cron, heartbeat };
  enum EngineState { notInstalled, starting, ready, failed };

  dictionary Routine {
    DOMString id;
    DOMString title;
    DOMString prompt;
    RoutineKind kind;
    long everyMinutes;
    PermissionMode mode;
    Effort effort;
    boolean enabled;
    DOMString taskId;
    double lastRunMs;
    double nextRunMs;
    DOMString lastError;
  };

  dictionary MemoryEntry {
    DOMString id;
    DOMString text;
    DOMString source;
    double createdMs;
    boolean pinned;
  };

  dictionary MemorySettings {
    boolean enabled;
    long retentionDays;
    MemoryEntry[] entries;
  };

  dictionary Provider {
    DOMString id;
    DOMString providerLabel;
    DOMString model;
    DOMString endpoint;
    boolean hasSecret;
    boolean isOauth;
  };

  dictionary EngineInfo {
    EngineState state;
    DOMString defaultModel;
    long modelCount;
  };

  dictionary ModelSettings {
    Provider[] providers;
    DOMString selectedId;
    EngineInfo engine;
    boolean encryptionReady;
  };

  dictionary PasswordSettings {
    boolean offerToSave;
    boolean autoSignin;
    DOMString choice;
  };

  dictionary ChatSummary {
    DOMString id;
    DOMString prompt;
  };

  dictionary RpcSettings {
    boolean enabled;
    DOMString endpoint;
    DOMString handleFileName;
  };

  dictionary AgentSettings {
    DOMString workingFolder;
    MemorySettings memory;
    ModelSettings model;
    PasswordSettings passwords;
    Routine[] routines;
    ChatSummary[] chats;
    RpcSettings rpc;
  };

  callback GetSettingsCallback = void (AgentSettings settings);

  interface Functions {
    // Returns the browser's full version string (the same value shown on
    // chrome://version). Resolves a Promise on MV3.
    // |callback|: Called with the version string.
    static void getBrowserVersion(GetBrowserVersionCallback callback);

    // Records the first-run password-manager choice as a profile pref, so the
    // decision survives the onboarding window being torn down. Unknown values
    // are ignored. |choice|: one of "redrob", "external", "skip".
    static void setPasswordChoice(DOMString choice);

    // Records the first-run model choice as a profile pref. Unknown values are
    // ignored. |choice|: one of "redrob", "chatgpt", "claude".
    static void setModelChoice(DOMString choice);

    // Lists other browsers on this machine with data that could be imported.
    // Detection reads other browsers' profile directories, so it is async and
    // resolves late; an empty array means none were found, not still loading.
    static void getImportSources(GetImportSourcesCallback callback);

    // Starts an import from the source at |sourceIndex| in the last
    // getImportSources() result, into this profile. An import is not
    // instantaneous, so progress and the outcome do NOT return here; they
    // arrive on onImportStateChanged. Starting a second import while one runs
    // is ignored.
    static void startImport(long sourceIndex);

    // Ends the first run. When onboarding is shown inside the first-run window
    // (which hosts this extension page), this fires the browser's own
    // completion — mark first run finished, tear the window down, open the
    // browser. The page cannot do any of that itself. A no-op when onboarding
    // was opened as an ordinary tab (there is no first-run window to end).
    static void completeOnboarding();
  };

  interface Events {
    // Fired as an import progresses and when it ends. |message| carries the
    // user-facing reason on sourceBusy/failed, and is absent otherwise.
    static void onImportStateChanged(ImportState state, optional DOMString message);
    // Returns the whole AgentSettings tree — working folder, memory, model
    // providers + engine state, password toggles, routines, recent chats, and
    // the loopback RPC endpoint. Assembled from the same stores the settings
    // WebUI read.
    static void getSettings(GetSettingsCallback callback);

    // Turns the agent's memory on or off. Delegates to the profile's memory
    // store, which is where the setting actually lives.
    static void setMemoryEnabled(boolean enabled);

    // Sets how many days memory entries are kept before they age out.
    static void setMemoryRetentionDays(long days);

    // Clears all memory entries. Named for what it does, not softened: it is
    // irreversible and the UI must confirm before calling it.
    static void forgetAllMemory();

    // Removes one memory entry. Resolves true if it existed and was removed.
    static void removeMemory(DOMString id, BoolCallback callback);

    // Pins or unpins a memory entry so it is kept regardless of retention.
    static void setMemoryPinned(DOMString id, boolean pinned, BoolCallback callback);

    // Removes a saved routine. Resolves true if it existed.
    static void removeRoutine(DOMString id, BoolCallback callback);

    // Enables or disables a routine without deleting it.
    static void setRoutineEnabled(DOMString id, boolean enabled, BoolCallback callback);

    // Removes a model provider. Resolves true if it existed.
    static void removeProvider(DOMString id, BoolCallback callback);

    // Makes the given provider the selected one. Resolves true on success.
    static void selectProvider(DOMString id, BoolCallback callback);

    // Adds a model provider. |secret| is the API key: it travels one way, into
    // the store, and is never read back out by getSettings.
    // |providerLabel|: the name shown for it ("label" is reserved in this idl).
    // |callback|: the new provider's id, or nothing if it was not stored.
    static void addProvider(DOMString providerLabel,
                            DOMString model,
                            DOMString endpoint,
                            DOMString secret,
                            StringCallback callback);

    // Turns the "offer to save passwords" prompt on or off.
    static void setOfferToSavePasswords(boolean enabled);

    // Turns automatic sign-in with a saved password on or off.
    static void setPasswordAutoSignin(boolean enabled);

    // Records which password manager the user chose: "redrob", "external" or
    // "skip". Any other value is ignored. Choosing "external" also stops
    // offering to save — it does NOT delete credentials already stored.
    static void setPasswordManagerChoice(DOMString choice);

    // Starts or stops the local RPC server now, not at the next launch.
    // |callback|: the endpoint it is listening on, or nothing when it is off or
    // failed to start.
    static void setRpcEnabled(boolean enabled, StringCallback callback);

    // Forgets the agent's working folder.
    static void clearWorkingFolder();

    // Adds a routine. |callback|: the new routine's id, or nothing if it was
    // not stored. lastRunMs, nextRunMs and lastError are reported by
    // getSettings and ignored here — the store owns them.
    static void addRoutine(Routine routine, StringCallback callback);

    // Updates an existing routine in place. Resolves true if it existed.
    static void updateRoutine(Routine routine, BoolCallback callback);

    // Runs a routine now, without waiting for its schedule.
    // |callback|: the id of the task it started, or nothing if it did not start.
    static void runRoutineNow(DOMString id, StringCallback callback);
  };
};
