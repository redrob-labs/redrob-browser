// The <code>chrome.redrobPrivate</code> API is the single, component-gated
// bridge by which Redrob's own bundled extensions reach browser capability
// that a Web-facing extension API does not expose. It is restricted to
// component extensions in _permission_features.json; an ordinary extension
// cannot hold the permission, so this is the ONE crossing point the ownership
// boundary (docs/OWNERSHIP.md) allows.
//
// getBrowserVersion is deliberately the smallest possible method: it proves an
// extension can call into native through the fork-restricted permission, which
// is all the foundation item F-1 has to establish. The real surfaces
// (browser preferences, the omnibox agent) are added here as their WebUI
// migrates in later phases, each as one more function on this interface.
namespace redrobPrivate {
  callback GetBrowserVersionCallback = void (DOMString version);
  callback BoolCallback = void (boolean ok);
  // Resolves with a string when there is one, and with nothing when the
  // operation has no result to report — an absent value is not an empty one.
  callback StringCallback = void (optional DOMString value);

  // The two shapes a preference getter resolves with. Separate from
  // BoolCallback and StringCallback on purpose: those two mean "did it work"
  // and "a result if there was one", whereas a registered preference always
  // has a value, so an optional or an ok-flag would misdescribe it.
  callback BooleanPrefCallback = void (boolean value);
  callback StringPrefCallback = void (DOMString value);

  // A browser found on this machine that onboarding could import from. Mirrors
  // the onboarding ImportSource mojom struct: each capability flag is read from
  // the source's own bitmask, because what one browser hands over is not what
  // another can.
  dictionary ImportSource {
    // What to call it in the UI, e.g. "Google Chrome".
    DOMString name;
    boolean hasBookmarks;
    boolean hasHistory;
    boolean hasPasswords;
    boolean hasSearchEngines;
    // Always false today: upstream defines the bit but nothing implements it.
    boolean hasCookies;
  };

  callback GetImportSourcesCallback = void (ImportSource[] sources);

  // How an import is going. Matches the onboarding ImportState mojom enum.
  enum ImportState {
    // The source browser is running and holds its data open. Recoverable: the
    // user closes it and retries, which is why it is its own state.
    idle,
    running,
    succeeded,
    sourceBusy,
    failed
  };

  // Mirrors of the settings mojom structs, so GetSettings can return the whole
  // AgentSettings tree over the private API. Enums are string enums (idl
  // convention); the mojom's kFoo values become "foo".
  enum PermissionMode { readOnly, guard, fullAccess };
  enum Effort { quick, standard, ultrabrowse };

  // Mirrors of the agent mojom's task types (A-1), so the agent surface can move
  // to the extension. PermissionMode and Effort above are the SAME enums the
  // agent mojom uses, so they are not duplicated here.
  enum TaskState { queued, running, blockedOnPolicy, succeeded, failed, cancelled };

  // What the agent did, one entry per action. The list is the honest record of a
  // run; a task that only reported a final answer could not be checked.
  enum StepKind {
    thinking,
    searchedMemory,
    openedPage,
    capturedScreenshot,
    readPage,
    clicked,
    typed,
    savedArtifact,
    refused,
    usedCredential,
    spawnedSubagents,
    steered,
    queuedMessage,
    planned,
    routine
  };

  dictionary StepDetail {
    DOMString text;
    DOMString? source;
    DOMString? timing;
  };

  dictionary Step {
    StepKind kind;
    DOMString stepLabel;
    double startedAtMs;
    StepDetail[] details;
    DOMString? previewDataUrl;
  };

  dictionary Task {
    DOMString id;
    DOMString prompt;
    TaskState state;
    Step[] steps;
    DOMString? narration;
    double startedAtMs;
    DOMString? error;
    PermissionMode mode;
    DOMString? workingFolder;
    Effort effort;
    DOMString model;
    DOMString[] queued;
  };

  dictionary ModelOption {
    DOMString id;
    DOMString providerId;
    DOMString name;
    DOMString[] capabilities;
    DOMString priceBand;
  };

  // What happened to a message typed into a running task's composer.
  enum FollowUpOutcome { startedTurn, interrupted, queued, rejected };

  // What the caller asked for. `auto` lets the browser decide between
  // interrupting and queueing.
  enum FollowUpMode { auto, interrupt, queue };

  // Why a task could not start. Every one of these is a bound the browser
  // enforces, not a message from the engine.
  enum StartError { emptyPrompt, sidecarUnavailable, tooManyRunningTasks };

  // Exactly one of these is set.
  //
  // A dictionary rather than two optional positional arguments: the mojom
  // returns (string? task_id, StartError? error), and a callback whose FIRST
  // argument may be absent forces every JS caller to tell "not started" from
  // "started, id missing" by counting arguments. Naming them removes that.
  dictionary StartTaskResult {
    DOMString? taskId;
    StartError? error;
  };
  // consolidate is the built-in memory review: one per profile, reported so
  // Settings can show it, refused by addRoutine and removeRoutine.
  enum RoutineKind { cron, heartbeat, consolidate };
  enum EngineState { notInstalled, starting, ready, failed };

  dictionary Routine {
    DOMString id;
    DOMString title;
    DOMString prompt;
    RoutineKind kind;
    long everyMinutes;
    PermissionMode mode;
    Effort effort;
    boolean enabled;
    DOMString taskId;
    double lastRunMs;
    double nextRunMs;
    DOMString lastError;
  };

  // Memory is a folder of markdown files (docs/MEMORY.md). A file is named by
  // its path relative to that folder, with '/' separators.
  dictionary MemoryFile {
    DOMString path;
    double bytes;
    double modifiedMs;
  };

  // What a run did to one file, in lines.
  dictionary MemoryFileChange {
    DOMString path;
    long added;
    long removed;
  };

  // Who changed memory: extraction after a task, consolidation, the user in
  // Settings, or a revert.
  enum MemoryRunKind { extract, consolidate, user, revert };

  dictionary MemoryRun {
    // Also the name of the run's snapshot. Pass it to revertMemoryRun.
    DOMString id;
    MemoryRunKind kind;
    double startedMs;
    // 0 while the run is still going.
    double durationMs;
    // 0 when the engine reported no usage.
    double tokens;
    MemoryFileChange[] files;
    boolean finished;
    // Only a run that wrote something has a snapshot, and only such a run can
    // be reverted.
    boolean revertible;
  };

  dictionary MemorySettings {
    boolean enabled;
    long retentionDays;
    // Whether extraction may see the titles and URLs the agent's own tab
    // visited during the task.
    boolean historyInput;
    MemoryFile[] files;
    // Newest first, at most 30.
    MemoryRun[] runs;
    // When consolidation last ran, unix ms; 0 = never.
    double lastConsolidationMs;
  };

  dictionary Provider {
    DOMString id;
    DOMString providerLabel;
    DOMString model;
    DOMString endpoint;
    boolean hasSecret;
    boolean isOauth;
  };

  dictionary EngineInfo {
    EngineState state;
    DOMString defaultModel;
    long modelCount;
  };

  dictionary ModelSettings {
    Provider[] providers;
    DOMString selectedId;
    // What first run recorded on the subscription screen: "redrob", "chatgpt" or
    // "claude", and empty before it was asked. A subscription FAMILY, deliberately
    // not the same field as selectedId above, which names a configured provider
    // entry. Reported so a surface can show the user what they chose; honouring it
    // needs a provider to point selectedId at, which is separate work.
    DOMString onboardingChoice;
    EngineInfo engine;
    boolean encryptionReady;
  };

  dictionary PasswordSettings {
    boolean offerToSave;
    boolean autoSignin;
    DOMString choice;
  };

  dictionary ChatSummary {
    DOMString id;
    DOMString prompt;
  };

  dictionary RpcSettings {
    boolean enabled;
    DOMString endpoint;
    DOMString handleFileName;
  };

  dictionary AgentSettings {
    DOMString workingFolder;
    MemorySettings memory;
    ModelSettings model;
    PasswordSettings passwords;
    Routine[] routines;
    ChatSummary[] chats;
    RpcSettings rpc;
  };

  // Where an engine install has got to.
  //
  // `notInstalled` and `installed` are the two resting states; the middle four
  // are a run in progress, and `failed` carries the reason the last run
  // stopped. Deliberately NOT the same enum as EngineState above: that one says
  // whether the engine is RUNNING, which is a different question with a
  // different answer -- an engine can be installed and not running.
  enum EngineInstallState {
    notInstalled,
    resolving,
    downloading,
    verifying,
    extracting,
    installed,
    failed
  };

  dictionary EngineInstallInfo {
    EngineInstallState state;
    // 0..100, set only while downloading. Absent everywhere else, because a
    // percentage that has stopped measuring anything reads as a stalled
    // download rather than as a step that has moved on.
    long? percent;
    // The release being installed, or the one installed, e.g. "v0.4.1". Absent
    // until the release has been resolved.
    DOMString? version;
    // The user-facing reason. Set only on failed.
    DOMString? error;
  };

  // What the extension needs to talk to the engine, handed over per call rather
  // than stored.
  //
  // F-5. The extension used to keep the credential in chrome.storage.local and,
  // when that copy was absent, send its requests with no Authorization header at
  // all. An engine on loopback that requires no credential answers every process
  // on the machine, and this engine runs shell commands and holds provider keys.
  //
  // `credential` is absent when this browser did not launch the engine. That is
  // not a reason to proceed unauthenticated -- it is the signal to refuse, and
  // the extension treats it that way.
  dictionary EngineCredential {
    DOMString? credential;
    // Where the engine is actually listening, so the extension stops carrying its
    // own guess at the port alongside its own guess at the secret.
    DOMString? baseUrl;
  };

  callback GetEngineCredentialCallback = void (EngineCredential result);
  callback GetEngineInstallStateCallback = void (EngineInstallInfo info);  callback GetSettingsCallback = void (AgentSettings settings);
  callback ListModelsCallback = void (ModelOption[] options);
  callback ListTasksCallback = void (Task[] tasks);
  // Resolves with a task when there is one, and with nothing when there is not.
  callback GetTaskCallback = void (optional Task task);
  callback StartTaskCallback = void (StartTaskResult result);
  callback FollowUpCallback = void (FollowUpOutcome outcome);

  interface Functions {
    // Returns the browser's full version string (the same value shown on
    // chrome://version). Resolves a Promise on MV3.
    // |callback|: Called with the version string.
    static void getBrowserVersion(GetBrowserVersionCallback callback);

    // Records the first-run password-manager choice as a profile pref, so the
    // decision survives the onboarding window being torn down. Unknown values
    // are ignored. |choice|: one of "redrob", "external", "skip".
    static void setPasswordChoice(DOMString choice);

    // Records the first-run model choice as a profile pref. Unknown values are
    // ignored. |choice|: one of "redrob", "chatgpt", "claude".
    static void setModelChoice(DOMString choice);

    // Lists other browsers on this machine with data that could be imported.
    // Detection reads other browsers' profile directories, so it is async and
    // resolves late; an empty array means none were found, not still loading.
    static void getImportSources(GetImportSourcesCallback callback);

    // Starts an import from the source at |sourceIndex| in the last
    // getImportSources() result, into this profile. An import is not
    // instantaneous, so progress and the outcome do NOT return here; they
    // arrive on onImportStateChanged. Starting a second import while one runs
    // is ignored.
    static void startImport(long sourceIndex);

    // Ends the first run. When onboarding is shown inside the first-run window
    // (which hosts this extension page), this fires the browser's own
    // completion — mark first run finished, tear the window down, open the
    // browser. The page cannot do any of that itself. A no-op when onboarding
    // was opened as an ordinary tab (there is no first-run window to end).
    static void completeOnboarding();

    // Returns the whole AgentSettings tree — working folder, memory, model
    // providers + engine state, password toggles, routines, recent chats, and
    // the loopback RPC endpoint. Assembled from the same stores the settings
    // WebUI read.
    static void getSettings(GetSettingsCallback callback);

    // Turns the agent's memory on or off. Delegates to the profile's memory
    // store, which is where the setting actually lives.
    static void setMemoryEnabled(boolean enabled);

    // Sets how many days memory entries are kept before they age out.
    static void setMemoryRetentionDays(long days);

    // Deletes every memory file, every snapshot and the run history. Named for
    // what it does, not softened: it is irreversible and the UI must confirm
    // before calling it.
    static void forgetAllMemory();

    // Deletes one memory file. |id| is the file's path. Recorded as a user run,
    // so it can be reverted. Resolves true if the file is gone.
    static void removeMemory(DOMString id, BoolCallback callback);

    // Retired: memory is files now, and files are not pinned. Kept so the
    // function id stays stable; always resolves false.
    static void setMemoryPinned(DOMString id, boolean pinned, BoolCallback callback);

    // Removes a saved routine. Resolves true if it existed.
    static void removeRoutine(DOMString id, BoolCallback callback);

    // Enables or disables a routine without deleting it.
    static void setRoutineEnabled(DOMString id, boolean enabled, BoolCallback callback);

    // Removes a model provider. Resolves true if it existed.
    static void removeProvider(DOMString id, BoolCallback callback);

    // Makes the given provider the selected one. Resolves true on success.
    static void selectProvider(DOMString id, BoolCallback callback);

    // Adds a model provider. |secret| is the API key: it travels one way, into
    // the store, and is never read back out by getSettings.
    // |providerLabel|: the name shown for it ("label" is reserved in this idl).
    // |callback|: the new provider's id, or nothing if it was not stored.
    static void addProvider(DOMString providerLabel,
                            DOMString model,
                            DOMString endpoint,
                            DOMString secret,
                            StringCallback callback);

    // Turns the "offer to save passwords" prompt on or off.
    static void setOfferToSavePasswords(boolean enabled);

    // Turns automatic sign-in with a saved password on or off.
    static void setPasswordAutoSignin(boolean enabled);

    // Records which password manager the user chose: "redrob", "external" or
    // "skip". Any other value is ignored. Choosing "external" also stops
    // offering to save — it does NOT delete credentials already stored.
    static void setPasswordManagerChoice(DOMString choice);

    // --- Window and tab preferences -------------------------------------
    //
    // Four behaviours, a getter and a setter each, and NOTHING on the native
    // side reads them yet. They are the stored half of the vertical-tab,
    // horizontal-tab, translucency and picture-in-picture items; the window
    // and tab code that acts on them is a separate item. A page can set one
    // today and read back what it set, and the browser will look the same —
    // that is the intended state, not an unfinished one, and every default is
    // current behaviour so the first reader to arrive changes nothing.

    // Where a newly opened tab is inserted in the vertical tab rail:
    // "after_current" (below the tab that opened it) or "end" (bottom of the
    // rail).
    static void getVerticalTabInsertionPosition(StringPrefCallback callback);

    // Sets the vertical tab insertion position. Accepts "after_current" and
    // "end"; any other value is ignored rather than stored, because this
    // arrives from a renderer and is read back out.
    static void setVerticalTabInsertionPosition(DOMString position);

    // Whether horizontal tabs shrink as they multiply rather than holding a
    // minimum width and letting the strip scroll.
    static void getHorizontalTabShrinkEnabled(BooleanPrefCallback callback);

    // Turns horizontal tab shrinking on or off.
    static void setHorizontalTabShrinkEnabled(boolean enabled);

    // Whether the window paints a translucent background behind its chrome.
    static void getWindowTranslucencyEnabled(BooleanPrefCallback callback);

    // Turns window background translucency on or off.
    static void setWindowTranslucencyEnabled(boolean enabled);

    // Whether a video entering the background may open picture-in-picture
    // without the user asking.
    static void getAutomaticPictureInPictureEnabled(
        BooleanPrefCallback callback);

    // Turns automatic picture-in-picture on or off.
    static void setAutomaticPictureInPictureEnabled(boolean enabled);

    // --- Colour scheme ----------------------------------------------------
    //
    // The browser's own light/dark choice (ThemeService's BrowserColorScheme,
    // the pref chrome://settings/appearance writes). The extension's pages read
    // and write THIS instead of keeping a theme of their own, so the window and
    // the side panel beside it can never disagree about which theme they are in.
    // "system", "light" or "dark".
    static void getColorScheme(StringPrefCallback callback);

    // Sets the browser's colour scheme. Accepts "system", "light" and "dark";
    // any other value is ignored rather than stored, because this arrives from a
    // renderer. Goes through ThemeService, not the raw pref, so the window
    // re-themes the way it does when the setting is changed in Settings.
    static void setColorScheme(DOMString scheme);

    // Starts or stops the local RPC server now, not at the next launch.
    // |callback|: the endpoint it is listening on, or nothing when it is off or
    // failed to start.
    static void setRpcEnabled(boolean enabled, StringCallback callback);

    // Forgets the agent's working folder.
    static void clearWorkingFolder();

    // Adds a routine. |callback|: the new routine's id, or nothing if it was
    // not stored. lastRunMs, nextRunMs and lastError are reported by
    // getSettings and ignored here — the store owns them.
    static void addRoutine(Routine routine, StringCallback callback);

    // Updates an existing routine in place. Resolves true if it existed.
    static void updateRoutine(Routine routine, BoolCallback callback);

    // Runs a routine now, without waiting for its schedule.
    // |callback|: the id of the task it started, or nothing if it did not start.
    static void runRoutineNow(DOMString id, StringCallback callback);

    // Asks the user for the folder agent tasks may write into, and records it.
    // The dialog is opened by the browser and is modal to this page's window.
    // |callback|: the chosen folder's display name, or nothing if the user
    // cancelled, the path was not absolute, or the platform had no dialog.
    static void chooseWorkingFolder(StringCallback callback);

    // Starts an OAuth sign-in for a NEW model provider. The provider entry is
    // written only once tokens actually arrive, so a cancelled sign-in leaves
    // nothing behind. The authorize page is opened by the BROWSER in a new tab,
    // not by the caller.
    // |callback|: an error message if the sign-in could not be started, or
    // nothing when it was started.
    static void beginProviderSignIn(DOMString providerLabel,
                                    DOMString model,
                                    DOMString endpoint,
                                    DOMString authorizeUrl,
                                    DOMString tokenUrl,
                                    DOMString clientId,
                                    DOMString scopes,
                                    StringCallback callback);

    // Opens Chromium's own password manager, reusing its tab if it is open.
    static void openPasswordManager();

    // The models the engine can route to right now. An empty list is a real
    // answer: the engine may not be serving.
    static void listModels(ListModelsCallback callback);

    // Every task this session knows about, newest first.
    static void listTasks(ListTasksCallback callback);

    // One task by id. |callback|: the task, or NOTHING when there is no such
    // task — a tab's URL is a string a renderer can put anything in, including
    // the id of a task from a previous browser session, so "no such task" is an
    // ordinary answer rather than an error.
    static void getTask(DOMString taskId, GetTaskCallback callback);

    // Stops a task. Nothing to report: a task that was already finished or never
    // existed is simply not running now, which is what the caller wanted.
    static void cancelTask(DOMString taskId);

    // Changes what a running task is allowed to do. Resolves false when the task
    // is gone or will not accept the change.
    static void setPermissionMode(DOMString taskId,
                                  PermissionMode mode,
                                  BoolCallback callback);

    // Removes a queued follow-up. |expectedPrompt| is checked against what is
    // actually at |index|, so a stale view cannot withdraw the wrong message.
    // Resolves false when it no longer matches.
    static void withdrawQueuedFollowUp(DOMString taskId,
                                       long index,
                                       DOMString expectedPrompt,
                                       BoolCallback callback);

    // Searches with the browser's default engine, replacing THIS page rather
    // than opening a tab: the user typed into this surface and expects results
    // where they were. Does nothing when there is no default engine — policy can
    // remove it, and the choice screen leaves it unset until the user picks.
    static void searchWithDefaultProvider(DOMString query);

    // Starts a task. Every argument came from a renderer, so the browser is
    // where the bounds live: an empty prompt, no engine, or too many tasks
    // already running each come back as an error rather than a half-started task.
    // |contextRefs|: what the task may look at, by reference.
    // |model|: the wire model id. Empty takes the default.
    static void startTask(DOMString prompt,
                          DOMString[] contextRefs,
                          PermissionMode mode,
                          Effort effort,
                          DOMString model,
                          StartTaskCallback callback);

    // A message typed into a running task's composer. The outcome says what the
    // browser actually did with it — started a turn, interrupted, queued, or
    // refused — because "sent" is not one thing.
    static void sendFollowUp(DOMString taskId,
                             DOMString prompt,
                             FollowUpMode mode,
                             FollowUpCallback callback);

    // Asks the user for the folder ONE TASK may write into, and records it on
    // that task. Not the same call as chooseWorkingFolder, which sets the
    // profile-wide default: this one never touches the pref.
    // |callback|: the chosen folder's display name, or nothing if the user
    // cancelled, the task is unknown, or the platform had no dialog.
    static void chooseTaskWorkingFolder(DOMString taskId,
                                        StringCallback callback);

    // The credential and listener for the engine THIS browser launched, fetched
    // per use and never stored by the caller.
    //
    // Both fields absent means the browser has no engine running, which the
    // extension must treat as "do not send a request", not as "send one without
    // a credential" (F-5).
    static void getEngineCredential(GetEngineCredentialCallback callback);

    // Where the local engine install stands right now. One check for the binary
    // on the path the browser already searches, plus whatever a run in flight
    // has reached.
    static void getEngineInstallState(GetEngineInstallStateCallback callback);

    // Downloads this platform's engine release, checks it against the hash the
    // release itself publishes, and puts the binary where the browser already
    // looks for it.
    //
    // Progress arrives as onEngineInstallStateChanged rather than on a
    // callback, because an install outlives the call that began it -- the same
    // reason startImport() reports that way. A second call while one is already
    // running is ignored.
    static void installEngine();

    // --- Memory files (CAP-19) ---------------------------------------------

    // Reads one memory file. |callback|: its content, or nothing when the path
    // is not a memory path or no such file exists.
    static void readMemoryFile(DOMString path, StringCallback callback);

    // Replaces (or creates) one memory file with what the user typed in
    // Settings. Recorded as a user run, snapshotted first, so it can be
    // reverted. Resolves false when the path or the size is refused.
    static void writeMemoryFile(DOMString path,
                                DOMString content,
                                BoolCallback callback);

    // Puts the memory files back the way they were before run |runId| first
    // wrote. The revert is itself a run and can be reverted.
    static void revertMemoryRun(DOMString runId, BoolCallback callback);

    // Starts a consolidation run now, without the daily and three-run gate.
    // Resolves false when memory is off, one is already running, or there is
    // no engine.
    static void runMemoryConsolidation(BoolCallback callback);

    // Lets extraction see the titles and URLs the agent's own tab visited
    // during a task. Off by default.
    static void setMemoryHistoryInput(boolean enabled);
  };

  interface Events {
    // Fired as an import progresses and when it ends. |message| carries the
    // user-facing reason on sourceBusy/failed, and is absent otherwise.
    static void onImportStateChanged(ImportState state, optional DOMString message);

    // A task changed: it started, took a step, or finished. The whole task is
    // sent rather than a diff, because a page that missed an event would
    // otherwise be left with a record it cannot repair.
    //
    // redrobPrivate's other event, onImportStateChanged, is added by the
    // onboarding branch. Both will live in this block once both have merged.
    [supportsListeners] static void onTaskChanged(Task task);

    // An engine install moved: it resolved a release, downloaded a slice,
    // verified, extracted, finished, or failed. The whole state is sent rather
    // than a delta, for the same reason onTaskChanged sends the whole task -- a
    // page that missed one event would otherwise hold a record it cannot
    // repair, and here that record is a progress bar that never completes.
    [supportsListeners] static void onEngineInstallStateChanged(
        EngineInstallInfo info);
  };
};
