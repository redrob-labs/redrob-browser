import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions,
       "Cannot depend on extensions because enable_extensions=false.")

source_set("redrob_private") {
  sources = [
    "redrob_private_api.cc",
    "redrob_private_api.h",
    "redrob_private_engine_installer.cc",
    "redrob_private_engine_installer.h",
    "redrob_private_engine_installer_factory.cc",
    "redrob_private_engine_installer_factory.h",
    "redrob_private_import_manager.cc",
    "redrob_private_import_manager.h",
    "redrob_private_import_manager_factory.cc",
    "redrob_private_import_manager_factory.h",
    "redrob_private_onboarding_service.cc",
    "redrob_private_onboarding_service.h",
    "redrob_private_onboarding_service_factory.cc",
    "redrob_private_onboarding_service_factory.h",
    "redrob_private_folder_picker.cc",
    "redrob_private_folder_picker.h",
    "redrob_private_task_event_router.cc",
    "redrob_private_task_event_router.h",
    "redrob_private_task_event_router_factory.cc",
    "redrob_private_task_event_router_factory.h",
    "redrob_private_saved_secrets.cc",
    "redrob_private_saved_secrets.h",
    "redrob_private_saved_secrets_factory.cc",
    "redrob_private_saved_secrets_factory.h",
  ]

  # public_deps because the public header includes importer_list.h (the
  # unique_ptr<ImporterList> member needs the complete type wherever this
  # function class is used, including the generated API registration).
  public_deps = [ "//chrome/browser/importer" ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/redrob:sidecar",
    "//chrome/browser/search_engines",
    # getColorScheme / setColorScheme go through ThemeService.
    "//chrome/browser/themes",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/select_file_policy",
    "//components/keyed_service/core",
    "//components/password_manager/core/common",
    # Saved secrets: the stores the matcher is built from. Read into digests only.
    "//chrome/browser/password_manager:factories",
    "//components/autofill/core/browser",
    "//components/password_manager/core/browser",
    "//components/password_manager/core/browser/password_store:password_store_interface",
    "//components/search_engines",
    # The engine installer downloads an archive and unpacks it in the sandboxed
    # unzip service rather than in this process, which is why the unzip service
    # and the network stack are both here.
    "//components/services/unzip/content",
    "//components/services/unzip/public/cpp",
    "//components/services/unzip/public/mojom",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//chrome/common/extensions/api",
    "//components/keyed_service/core",
    "//components/prefs",
    "//components/user_data_importer/common",
    "//components/version_info",
    "//content/public/browser",
    "//extensions/browser",
    "//ui/shell_dialogs",
  ]
}
