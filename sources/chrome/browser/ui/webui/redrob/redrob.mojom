module redrob.mojom;

// The boundary between chrome://redrob and the browser process. See docs/AI_SURFACE.md.
//
// Deliberately small. Everything expensive -- inference, model routing, the policy gate -- is on the
// sidecar's side of the browser process, not on the page's side of this interface. The page states
// intent and receives a decision; it never chooses a model, holds a credential or reaches the network.

enum TaskState {
  kQueued,
  kRunning,
  kBlockedOnPolicy,
  kSucceeded,
  kFailed,
  kCancelled,
};

// What a task is allowed to make the browser do. Real, not decorative: the browser refuses a tool
// call this mode does not cover, and the refusal is reported back to the engine as a tool result so
// it can choose another route instead of retrying.
//
// The narrowest mode that can do the job is the right default, which is why kGuard rather than
// kFullAccess is what the composer starts on.
enum PermissionMode {
  // Open and read pages. Nothing that changes a page and nothing that touches the disk.
  kReadOnly,
  // Also click and type, and write files -- but only files the browser names, inside one folder the
  // user chose. The model never supplies a path.
  kGuard,
  // Also write outside that folder. Deliberately not the default and deliberately not what a task
  // gets by asking for it: a mode this wide is a decision the user makes, not the agent.
  kFullAccess,
};

// How much work the user is asking for. Real, not decorative: it decides the tool budget, whether
// the agent is asked to plan before it browses, and what reasoning effort the engine is told to use.
//
// The names describe the ANSWER rather than the machinery. "Ultrabrowse" is the deep one because that
// is what the surface calls it.
enum Effort {
  // One or two pages, no plan. What a lookup should cost.
  kQuick,
  // The default: enough rounds to open a few sources and reconcile them.
  kStandard,
  // Ultrabrowse. The agent writes a plan into the trace first, then works through it across many
  // sources with a much larger budget.
  kUltrabrowse,
};

// What kind of step this is. The page picks an icon from this rather than parsing the label, so a
// new step kind is a mojom change and not a string match that silently stops matching.
enum StepKind {
  kThinking,
  kSearchedMemory,
  kOpenedPage,
  kCapturedScreenshot,
  kReadPage,
  kClicked,
  kTyped,
  kSavedArtifact,
  // A tool the task's permission mode does not allow. Rendered as a refusal rather than hidden,
  // because a user watching a trace should see what the agent wanted to do and did not get to do.
  kRefused,
  kUsedCredential,
  kSpawnedSubagents,
  // The user interrupted a running task with a new instruction. In the trace because the reason the
  // agent changed direction should be visible next to the direction it changed to.
  kSteered,
  // The user's instruction arrived mid-run and is waiting for the current step to finish.
  kQueuedMessage,
  // Ultrabrowse's plan, one detail row per intended step.
  kPlanned,
  // A routine started this task, or woke it.
  kRoutine,
};

// One step the agent took, as the page needs to render it.
struct Step {
  StepKind kind;
  string label;
  int64 started_at_ms;
  // Rows shown under the step when it is expanded -- the search hits, the files touched. Plain text
  // and a source label, never a URL the page could be tricked into following.
  array<StepDetail> details;
  // A frame the browser captured for this step, as a data URL the browser produced. Not a file path
  // and not a token the renderer resolves: the page renders exactly what it is given.
  string? preview_data_url;
};

struct StepDetail {
  string text;
  string? source;
  string? timing;
};

struct Task {
  string id;
  string prompt;
  TaskState state;
  array<Step> steps;
  // The agent's prose, interleaved before the steps it explains. One string because the page renders
  // it as one block; a transcript model belongs in the sidecar's session store, not here.
  string? narration;
  int64 started_at_ms;
  // Set only in kFailed. Carries the sidecar's reason, never a raw transport error: a 401 from the
  // engine must not reach a renderer as anything a page could learn a credential from.
  string? error;
  // What this task is allowed to do, and where it may write. Sent to the page so the task tab shows
  // the posture it is actually running under rather than what the composer was set to at some point.
  PermissionMode mode;
  string? working_folder;
  // How much work was asked for. On the task rather than only on the request, so a task tab reopened
  // later still shows the effort it actually ran at.
  Effort effort;
  // The wire id this task runs on, for the same reason effort is here: a task tab reopened later should
  // show the model it ACTUALLY ran at, not whatever the chooser happens to be set to now. Empty for
  // tasks started before a model could be chosen, which the view renders as the default.
  string model;
  // Instructions the user typed while this task was mid-run, still waiting for a safe boundary. Their
  // own words, echoed back so they can see what is pending rather than wondering if it was lost.
  array<string> queued;
};

// One model the local engine says this machine can actually run. Mirrors the fields the engine's
// /config/providers returns that a chooser needs -- not the whole record, because cost limits and
// request headers are the engine's business and a renderer has no use for them.
struct ModelOption {
  // The wire id, e.g. "redrob/auto" or "provider/model". What goes into StartTask.
  string id;
  // The provider half, for grouping.
  string provider_id;
  // What a human reads.
  string name;
  // Present so the chooser can filter on them rather than inventing categories.
  array<string> capabilities;
  // Empty when the engine does not price this model.
  string price_band;
};

// What happened to a message typed into a running task's composer.
enum FollowUpOutcome {
  // The task was idle, so this simply became its next turn.
  kStartedTurn,
  // The task was mid-run and was interrupted: the current completion was dropped and this took over.
  kInterrupted,
  // The task was mid-run and this is waiting for the current step to finish.
  kQueued,
  kRejected,
};

// What to do with a message typed while a task is running.
enum FollowUpMode {
  // Let the browser decide: start a turn if idle, queue if not. What pressing Enter does.
  kAuto,
  // Stop what it is doing now and take this instead.
  kInterrupt,
  // Let it finish the step it is on, then take this.
  kQueue,
};

// Why a task could not be started. Separate from Task.error because this answers a call rather than
// describing a run, and the page treats them differently.
enum StartError {
  kEmptyPrompt,
  kSidecarUnavailable,
  kTooManyRunningTasks,
};

interface Page {
  // Streamed rather than polled: a task card updates step by step.
  OnTaskChanged(Task task);
};

interface TaskHost {
  // `context_refs` are opaque handles the browser process resolves -- a tab, a selection, a
  // bookmark. Not URLs and not paths: a renderer that asks for /etc/passwd gets a rejected ref.
  // `model` is the wire id the task runs on. Empty means "let the browser use its default", which is
  // what every caller sent implicitly before this argument existed -- the store held one hardcoded
  // constant and no caller could influence it, so a task's model was a fact about the source code
  // rather than a choice.
  StartTask(string prompt, array<string> context_refs, PermissionMode mode, Effort effort, string model)
      => (string? task_id, StartError? error);
  // What the local engine says is available. Empty when no engine is reachable, which is the normal
  // state on a machine that has never installed one -- the caller shows that rather than an empty list
  // pretending to be a catalogue.
  ListModels() => (array<ModelOption> options);
  CancelTask(string task_id);
  ListTasks() => (array<Task> tasks);
  // One task, for the task tab view. Null when the id is unknown, which a renderer can ask for.
  GetTask(string task_id) => (Task? task);
  // A message typed into an existing task's composer. When the task is idle this is its next turn.
  // When it is mid-run the user chooses between interrupting it and letting it finish the step first,
  // which is the difference between steering and queueing -- and is why this is one call with a mode
  // rather than a `Reply` that silently means something different depending on timing.
  SendFollowUp(string task_id, string prompt, FollowUpMode mode) => (FollowUpOutcome outcome);
  // Withdraws one message the user queued that has not run yet. Queueing was already reversible in
  // principle -- the words sit in `Task.queued` doing nothing until a boundary -- but there was no way
  // to take one back, so a typo or a change of mind had to be waited out and then undone by hand.
  //
  // Identified by index AND the text the page believes is at it: the queue drains on its own when the
  // current step finishes, so between a render and a click the entry can already be gone or have
  // shifted, and an index alone would then withdraw a DIFFERENT message than the one clicked. A
  // mismatch returns false and changes nothing; the page redraws from the next OnTaskChanged, which is
  // the authority on what is still pending.
  WithdrawQueuedFollowUp(string task_id, uint32 index, string expected_prompt) => (bool withdrawn);
  // Changes an existing task's mode. Narrowing always succeeds; WIDENING is refused mid-task, because
  // a task that has already been running is not the moment to hand it more of the machine.
  SetPermissionMode(string task_id, PermissionMode mode) => (bool accepted);
  // The folder a task may write into, chosen through the browser's own picker so the returned path is
  // one the user saw and agreed to. Null when they cancelled. Only the folder's NAME comes back: a
  // renderer with the absolute path has learned something about the machine it has no use for.
  ChooseWorkingFolder(string task_id) => (string? display_path);
};

interface PageHandlerFactory {
  CreateTaskHost(pending_remote<Page> page, pending_receiver<TaskHost> host);
};
