import("//mojo/public/tools/bindings/mojom.gni")

# The agent surface is the vendored extension now, not a C++ WebUI, so the chrome://redrob controller
# (redrob_ui.*) and its per-document Mojo endpoint (task_host_impl.*) are gone. What stays is the Mojo
# IDL: redrob.mojom defines the task data types -- Task, PermissionMode, Effort, ModelOption -- that
# the profile's TaskStore, RoutineStore and the redrobPrivate extension API are written in terms of.
# Those are living code; the interfaces the deleted WebUI implemented (TaskHost, PageHandlerFactory)
# stay declared in the .mojom but are now unused, which compiles and keeps one definition of the types.
mojom("mojo_bindings") {
  sources = [ "redrob.mojom" ]
  webui_module_path = "/"
}
