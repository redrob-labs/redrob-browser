import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "redrob.mojom" ]
  webui_module_path = "/"
}

source_set("redrob") {
  sources = [
    "redrob_ui.cc",
    "redrob_ui.h",
    "task_host_impl.cc",
    "task_host_impl.h",
  ]
  deps = [
    ":mojo_bindings",
    "//base",
    "//chrome/browser/redrob:sidecar",
    "//chrome/browser/resources/redrob:resources",
    "//chrome/common",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
  ]
}
