import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "redrob_settings.mojom" ]
  webui_module_path = "/"
}

source_set("redrob_settings") {
  sources = [
    "redrob_settings_ui.cc",
    "redrob_settings_ui.h",
    "settings_host_impl.cc",
    "settings_host_impl.h",
  ]
  deps = [
    ":mojo_bindings",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/redrob:sidecar",
    "//chrome/browser/resources/redrob_settings:resources",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/select_file_policy",
    "//chrome/common",
    "//components/password_manager/core/common",
    "//components/prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/shell_dialogs",
    "//ui/webui",
  ]
}
