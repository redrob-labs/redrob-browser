module redrob.settings.mojom;

// The boundary between chrome://redrob-settings and the browser process.
//
// A separate surface from chrome://settings on purpose. Four new sections in upstream's Settings means
// touching its router, its page-visibility map, its menu markup, its main composition, its component
// list and two GRD files -- six files of upstream churn to maintain per release, for pages that are
// entirely ours. This host is one document with four sections and no upstream contact at all.
//
// The asymmetry to notice: a provider's API key goes IN through this interface and never comes back
// out. `has_secret` is the only thing the page learns about a stored credential.

enum PermissionMode {
  kReadOnly,
  kGuard,
  kFullAccess,
};

enum Effort {
  kQuick,
  kStandard,
  kUltrabrowse,
};

enum RoutineKind {
  // Starts a new task on a schedule.
  kCron,
  // Wakes an existing chat with its context.
  kHeartbeat,
};

struct Routine {
  string id;
  string title;
  string prompt;
  RoutineKind kind;
  int32 every_minutes;
  PermissionMode mode;
  Effort effort;
  bool enabled;
  // Heartbeat only.
  string task_id;
  double last_run_ms;
  double next_run_ms;
  // Why the last run did not happen. Empty when it did.
  string last_error;
};

struct MemoryEntry {
  string id;
  string text;
  // The task that produced it, so "why do you know this" is answered in the row.
  string source;
  double created_ms;
  bool pinned;
};

struct MemorySettings {
  bool enabled;
  // 0 means keep until deleted.
  int32 retention_days;
  array<MemoryEntry> entries;
};

struct Provider {
  string id;
  string label;
  string model;
  string endpoint;
  // Whether a key is on file. NEVER the key.
  bool has_secret;
};

struct ModelSettings {
  array<Provider> providers;
  // Empty means the built-in Redrob engine.
  string selected_id;
  // False until the platform keystore has answered. Adding a key before then is refused rather than
  // stored in the clear, and the page says so instead of failing silently.
  bool encryption_ready;
};

struct PasswordSettings {
  // Chromium's own manager: whether it offers to save, and whether it signs you in automatically.
  bool offer_to_save;
  bool auto_signin;
  // What the user chose during onboarding: "redrob", "external" or "skip".
  string choice;
};

// One row per chat, so a heartbeat routine can be pointed at a real conversation.
struct ChatSummary {
  string id;
  string prompt;
};

// The loopback endpoint that serves the CLI, the MCP server and the REPL.
struct RpcSettings {
  bool enabled;
  // Bound address, empty when not listening. Loopback only, on a port the OS chose.
  string endpoint;
  // Where the CLI reads the address and the per-launch token from. A NAME, not a path: the page
  // is told which file to mention, not where this profile lives on disk.
  string handle_file_name;
};

struct AgentSettings {
  // The folder tasks write into, as a display name. Never the path.
  string working_folder;
  MemorySettings memory;
  ModelSettings model;
  PasswordSettings passwords;
  array<Routine> routines;
  array<ChatSummary> chats;
  RpcSettings rpc;
};

interface SettingsHost {
  // Everything the page renders, in one call. Four sections that each fetched their own state would
  // paint at four different times on a page whose whole job is to be read.
  GetSettings() => (AgentSettings settings);

  AddRoutine(Routine routine) => (string? id);
  UpdateRoutine(Routine routine) => (bool ok);
  RemoveRoutine(string id) => (bool ok);
  SetRoutineEnabled(string id, bool enabled) => (bool ok);
  // Runs one immediately without moving its schedule. Returns the task it started or woke.
  RunRoutineNow(string id) => (string? task_id);

  SetMemoryEnabled(bool enabled);
  SetMemoryRetentionDays(int32 days);
  RemoveMemory(string id) => (bool ok);
  SetMemoryPinned(string id, bool pinned) => (bool ok);
  ForgetEverything();

  // `secret` crosses ONE way. It is encrypted through the platform keystore and never returned.
  AddProvider(string label, string model, string endpoint, string secret) => (string? id);
  RemoveProvider(string id) => (bool ok);
  SelectProvider(string id) => (bool ok);

  SetOfferToSavePasswords(bool enabled);
  SetPasswordAutoSignin(bool enabled);
  SetPasswordManagerChoice(string choice);
  // Opens Chromium's own password manager, which is where the credentials themselves live. This
  // surface deliberately does not reimplement it.
  OpenPasswordManager();

  // The browser's own folder picker, so the path is one the user saw. Returns the display name.
  // Turning this on binds the socket now; turning it off closes it and deletes the handle
  // file. Returns the endpoint it bound, or null.
  SetRpcEnabled(bool enabled) => (string? endpoint);

  ChooseWorkingFolder() => (string? display_path);
  ClearWorkingFolder();
};

interface PageHandlerFactory {
  CreateSettingsHost(pending_receiver<SettingsHost> host);
};
