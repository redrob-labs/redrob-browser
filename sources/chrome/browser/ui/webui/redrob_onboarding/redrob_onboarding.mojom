module redrob.onboarding.mojom;

// What the first-run flow needs from the browser. Deliberately small: the page decides what to show,
// the browser decides what is true.
interface OnboardingHost {
  // The choices a step recorded. Stored as profile prefs by the browser -- the page must not be the
  // thing that remembers them, because it is destroyed when the flow closes.
  SetPasswordChoice(string choice);
  SetModelChoice(string choice);

  // Which other browsers on this machine have data that could be imported. Empty when none were
  // found, which the page must show as "none found" rather than as a still-loading list.
  ListImportSources() => (array<ImportSource> sources);

  // Starts an import from `source_index` into this profile. Progress and the outcome arrive on the
  // Page interface, because an import is not instantaneous and the page has to keep saying so.
  StartImport(uint32 source_index);

  // Ends the first run. The browser owns what this means -- marking first run finished, tearing the
  // window down and opening the browser -- and the page cannot do any of it itself.
  Complete();
};

// A browser we could import from, as the browser process found it.
struct ImportSource {
  // What to call it in the UI, e.g. "Google Chrome".
  string name;
  // Which categories this source actually offers. Never assume a category is available: what one
  // browser can hand over is not what another can.
  bool has_bookmarks;
  bool has_history;
  bool has_passwords;
  bool has_search_engines;
  // Whether logged-in sessions can come across. Separate and explicit because it is the category
  // users care most about and the one most often not available.
  bool has_cookies;
};

enum ImportState {
  kIdle,
  kRunning,
  kSucceeded,
  // The source browser is running and holds its data open. Recoverable: the user closes it and
  // retries, which is why it is its own state rather than a generic failure.
  kSourceBusy,
  kFailed,
};

interface Page {
  OnImportStateChanged(ImportState state, string? message);
};

interface PageHandlerFactory {
  CreateOnboardingHost(pending_receiver<OnboardingHost> host, pending_remote<Page> page);
};
