import("//chrome/common/features.gni")
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "redrob_onboarding.mojom" ]
  webui_module_path = "/"
}

source_set("redrob_onboarding") {
  sources = [
    "onboarding_host_impl.cc",
    "onboarding_host_impl.h",
    "redrob_onboarding_ui.cc",
    "redrob_onboarding_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    # Redrob: the IDS_REDROB_* header behind kRedrobLocalizedStrings.
    "//chrome/browser/redrob/resources:redrob_strings",
    # Redrob: redrob::prefs::kPasswordManagerChoice, so the first-run decision lands on the pref the
    # settings page reads rather than on an unregistered path that PrefService drops.
    "//chrome/browser/redrob:sidecar",
    "//chrome/browser:browser_process",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/common",
    "//components/prefs",
    "//components/user_data_importer/common",
  ]
}
