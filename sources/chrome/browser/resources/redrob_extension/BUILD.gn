import("//chrome/common/features.gni")
import("//tools/grit/grit_rule.gni")

# The built `redrob-extension`, vendored by scripts/vendor_extension.py and packed into the resource
# bundle so Chromium can load it as a COMPONENT extension. That location is the whole point: the
# `redrobPrivate` and `settingsPrivate` permissions are gated on `location: component`, so an extension
# loaded any other way renders every surface with its "cannot reach the browser" banner.
#
# resources.grd is GENERATED. Its file list changes with every extension build (hashed chunk names), so
# re-vendor rather than editing it; the gate in scripts/check_repo.py refuses a grd out of step with the
# tree. grit discovers the inputs from the grd itself, which is why no `inputs` list appears here -- a
# second list would be a second thing to forget.
grit("resources") {
  source = "resources.grd"
  defines = chrome_grit_defines

  # Matches the convention chrome/chrome_paks.gni reads these paks from.
  output_dir = "$root_gen_dir/chrome"
  outputs = [
    "grit/redrob_extension_resources.h",
    "grit/redrob_extension_resources_map.cc",
    "grit/redrob_extension_resources_map.h",
    "redrob_extension_resources.pak",
  ]
}
