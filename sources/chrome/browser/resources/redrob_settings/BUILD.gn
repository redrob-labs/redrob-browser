import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "redrob_settings"
  static_files = [
    "redrob_settings.html",
    "tokens.css",
    "redrob_settings.css",
    "PretendardVariable.woff2",
  ]
  ts_files = [ "redrob_settings.ts" ]
  mojo_files_deps = [
    "//chrome/browser/ui/webui/redrob_settings:mojo_bindings_ts__generator",
  ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/redrob_settings/redrob_settings.mojom-webui.ts" ]
  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"
}
