import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "redrob_onboarding"
  static_files = [
    "redrob_onboarding.html",
    "tokens.css",
    "redrob_onboarding.css",
    "PretendardVariable.woff2",
    "redrob-mark.svg",
  ]
  ts_files = [ "redrob_onboarding.ts" ]
  mojo_files_deps = [
    "//chrome/browser/ui/webui/redrob_onboarding:mojo_bindings_ts__generator",
  ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/redrob_onboarding/redrob_onboarding.mojom-webui.ts" ]
  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"
}
