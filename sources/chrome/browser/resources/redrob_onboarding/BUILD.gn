import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "redrob_onboarding"
  static_files = [
    "redrob_onboarding.html",
    "chrome_base.css",
    "redrob_onboarding.css",
  ]
  ts_files = [
    "theme.ts",
    "redrob_onboarding.ts",
  ]
  mojo_files_deps = [
    "//chrome/browser/ui/webui/redrob_onboarding:mojo_bindings_ts__generator",
  ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/redrob_onboarding/redrob_onboarding.mojom-webui.ts" ]
  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  # The vendored design system, outside static_files. See build_design_system_grdp below.
  extra_grdp_files = [ "$target_gen_dir/design_system_resources.grdp" ]
  extra_grdp_deps = [ ":build_design_system_grdp" ]

  webui_context_type = "trusted"
}

# The design system's two sheets -- design_tokens.css (the values) and design_system.css (the 149 `.rr-*`
# component classes) -- are VENDORED (DESIGN_SYSTEM_PIN.json) and are shipped as resources rather than as
# static_files on purpose: build_webui runs stylelint over every *.css in static_files with Chromium's own
# config, and the design system's generated output does not match Chromium's house style -- double quotes,
# #ffffff over #fff, no blank line before a rule. That was 60 findings in design_tokens.css alone, in files
# we must not edit, and editing them to silence it would mean the pin no longer describes what we ship. A
# grdp entry puts the byte-identical file in the bundle at the same path and skips the linter, which has no
# bearing on a file nobody here writes.
#
# design_system.css must be linked AFTER design_tokens.css: it supersedes three roles the token sheet
# declares first. See DESIGN_SYSTEM_PIN.json and gate check 7.
generate_grd("build_design_system_grdp") {
  grd_prefix = "redrob_design_system"
  out_grd = "$target_gen_dir/design_system_resources.grdp"
  # All three bundles read the ONE vendored copy, in redrob/. Pointing this at "." instead would
  # make grit look for the fonts beside each page and fail on the two that do not have them -- and
  # "fix" itself by duplicating 1.7 MB of typeface into three source directories.
  input_files_base_dir = rebase_path("//chrome/browser/resources/redrob", "//")
  input_files = [
    # The brand symbol, both grounds. Here rather than in static_files for the same single-copy reason
    # as the fonts: three bundles show the mark and there is one pair of files.
    "brand/redrob-symbol-solid-white.png",
    "brand/redrob-symbol.png",
    "design_system.css",
    "design_tokens.css",
    "fonts/NotoSansDevanagari-Variable.woff2",
    "fonts/Pretendard-Bold.woff2",
    "fonts/Pretendard-ExtraBold.woff2",
    "fonts/Pretendard-Light.woff2",
    "fonts/Pretendard-Medium.woff2",
    "fonts/Pretendard-Regular.woff2",
    "fonts/Pretendard-SemiBold.woff2",
    "fonts/WantedSans-Variable.woff2",
  ]
}
