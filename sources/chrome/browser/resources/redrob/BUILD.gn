import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "redrob"
  static_files = [
    "redrob.html",
    "redrob.css",
    "redrob-mark.svg",
  ]
  ts_files = [ "redrob.ts" ]
  mojo_files_deps =
      [ "//chrome/browser/ui/webui/redrob:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/redrob/redrob.mojom-webui.ts" ]
  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"
}
