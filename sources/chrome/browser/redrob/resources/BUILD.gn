import("//tools/grit/grit_rule.gni")

# The fork's own translatable strings.
#
# A separate grd rather than entries in chrome/app/generated_resources.grd, for the reason patches/ exists
# at all: adding messages there means editing a 100,000-line upstream file AND its 84 .xtb files, every one
# of which is a rebase conflict at the next Chromium tag. A grd of our own is one file we own outright plus
# three lines of upstream wiring (the id range, the repack list, and a dep).
#
# grit_strings, not grit: the strings template knows about xtb_locales and produces the per-locale .pak files
# that chrome_repack_locales.gni folds into <locale>.pak. Both halves are needed -- the pak is what makes the
# translation reachable at runtime, and the header is what makes IDS_REDROB_* compile.
#
# The grd and its translations are GENERATED from l10n/*.tsv by scripts/gen_strings.py. Do not edit them
# here; `redrob.py check` fails if they drift from the TSV.
grit_strings("redrob_strings") {
  source = "redrob_strings.grd"
  outputs = [ "grit/redrob_strings.h" ]
}
