  <release seq="1" allow_pseudo="false">
    <messages fallback_to_english="true">
      <message name="IDS_REDROB_SIDEBAR_BOOKMARKS" desc="Sidebar section heading above the bookmark rows">Bookmarks</message>
      <message name="IDS_REDROB_SIDEBAR_CHATS" desc="Sidebar section heading above the agent chat rows">Chats</message>
      <message name="IDS_REDROB_SIDEBAR_TABS" desc="Sidebar section heading above the vertical tab strip">Tabs</message>
      <message name="IDS_REDROB_SIDEBAR_NEW_TAB" desc="First row of the Tabs section; opens a new tab">New Tab</message>
      <message name="IDS_REDROB_SIDEBAR_SETTINGS" desc="Row at the foot of the sidebar; opens the product's settings">Settings</message>
      <message name="IDS_REDROB_SIDEBAR_SEARCH_TABS" desc="Tooltip on the magnifier in the sidebar header">Search tabs</message>
      <message name="IDS_REDROB_SIDEBAR_NEW_TASK" desc="Tooltip on the compose button in the sidebar header">New task</message>
      <message name="IDS_REDROB_SIDEBAR_WORKSPACES" desc="Sidebar header button when no workspace is open in this window">Workspaces</message>
      <message name="IDS_REDROB_SIDEBAR_SWITCH_WORKSPACE" desc="Tooltip on the workspace button when there is at least one workspace">Switch workspace</message>
      <message name="IDS_REDROB_SIDEBAR_SAVE_GROUP_FOR_WORKSPACE" desc="Tooltip on the workspace button when the user has no workspaces yet">Save a tab group to make it a workspace</message>
      <message name="IDS_REDROB_SIDEBAR_UNTITLED_WORKSPACE" desc="Menu entry for a saved tab group the user never named">Untitled workspace</message>
      <message name="IDS_REDROB_SIDEBAR_BOOKMARKS_EMPTY" desc="Shown under the Bookmarks heading when the user has no bookmarks">Press Ctrl+D to keep a page here</message>
      <message name="IDS_REDROB_SIDEBAR_CHATS_EMPTY" desc="Shown under the Chats heading when the user has no agent tasks">Tasks you give the agent appear here</message>
      <message name="IDS_REDROB_SIDEBAR_NO_WORKSPACES_YET" desc="Disabled first item of the workspace menu, shown when none exist">No workspaces yet</message>
      <message name="IDS_REDROB_SIDEBAR_SAVE_WORKSPACE" desc="Workspace menu command that turns the window's tabs into a saved workspace">Save these tabs as a workspace</message>
      <message name="IDS_REDROB_NEW_TAB_PROMPT_LABEL" desc="Accessible name of the new tab's main input">Task for the agent</message>
      <message name="IDS_REDROB_NEW_TAB_PROMPT_PLACEHOLDER" desc="Placeholder in the new tab's main input">Ask AI to do something</message>
      <message name="IDS_REDROB_NEW_TAB_MODE_GROUP" desc="Accessible name of the Search / Ask AI pair">Mode</message>
      <message name="IDS_REDROB_NEW_TAB_MODE_SEARCH" desc="Segment that selects search mode; what is typed then goes to the web">Search</message>
      <message name="IDS_REDROB_NEW_TAB_MODE_ASK" desc="Segment that selects agent mode; what is typed then becomes a task">Ask AI</message>
      <message name="IDS_REDROB_NEW_TAB_PROMPT_PLACEHOLDER_SEARCH" desc="Placeholder in the new tab's main input while Search mode is selected">Search the web or type a URL</message>
      <message name="IDS_REDROB_NEW_TAB_ADD_CONTEXT" desc="Accessible name of the + button that attaches context">Add context</message>
      <message name="IDS_REDROB_NEW_TAB_PERMISSION_MODE" desc="Label of the control that picks how much the agent may do">Permission mode</message>
      <message name="IDS_REDROB_NEW_TAB_PERMISSION_READ" desc="Permission level: the agent may read pages and change nothing">Read only</message>
      <message name="IDS_REDROB_NEW_TAB_PERMISSION_GUARD" desc="Permission level: the agent asks before anything that changes something">Guard</message>
      <message name="IDS_REDROB_NEW_TAB_PERMISSION_FULL" desc="Permission level: the agent acts without asking">Full access</message>
      <message name="IDS_REDROB_NEW_TAB_MODEL" desc="Label of the model picker">Model</message>
      <message name="IDS_REDROB_NEW_TAB_EFFORT" desc="Label of the control that picks how hard the agent works">Effort</message>
      <message name="IDS_REDROB_NEW_TAB_EFFORT_QUICK" desc="Effort level: least work, fastest answer">Quick</message>
      <message name="IDS_REDROB_NEW_TAB_EFFORT_STANDARD" desc="Effort level: the default">Standard</message>
      <message name="IDS_REDROB_NEW_TAB_EFFORT_ULTRA" desc="Effort level: most work, slowest answer">Ultrabrowse</message>
      <message name="IDS_REDROB_NEW_TAB_SUGGESTED" desc="Heading above the three example tiles on an empty new tab">Suggested tasks</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_KIND_READ" desc="Tile category: the task only reads">Read</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_KIND_COMPARE" desc="Tile category: the task compares two things">Compare</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_KIND_ACT" desc="Tile category: the task changes something">Act</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_READ_TITLE" desc="Title of the summarise tile">Summarise a page</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_READ_DETAIL" desc="Body of the summarise tile">Open something and get the gist, with nothing changed.</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_READ_PROMPT" desc="The task text the summarise tile sends">Summarise this page in one sentence and list the links I can see.</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_COMPARE_TITLE" desc="Title of the compare tile">Compare two sources</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_COMPARE_DETAIL" desc="Body of the compare tile">A table of differences, with the gaps marked as gaps.</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_COMPARE_PROMPT" desc="The task text the compare tile sends">Compare these two pages and put the differences in a table. Say "not stated" where a page does not say.</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_ACT_TITLE" desc="Title of the form-filling tile">Fill a form, don't send it</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_ACT_DETAIL" desc="Body of the form-filling tile">Filled and left for you to check before submitting.</message>
      <message name="IDS_REDROB_NEW_TAB_TILE_ACT_PROMPT" desc="The task text the form-filling tile sends">Fill this form with my details but do not submit it, and tell me what you put where.</message>
      <message name="IDS_REDROB_NEW_TAB_RECENT" desc="Heading above the list of tasks the user actually ran">Recent tasks</message>
      <message name="IDS_REDROB_TASK_STOP" desc="Button that stops a running task">Stop</message>
      <message name="IDS_REDROB_TASK_BACK_HOME" desc="Accessible name of the control in a task's header that returns to the new tab">Back to the new tab</message>
      <message name="IDS_REDROB_TASK_CLOSE_PREVIEW" desc="Accessible name of the preview pane's close button">Close preview</message>
      <message name="IDS_REDROB_TASK_REPLY_LABEL" desc="Accessible name of the task view's reply input">Reply to the agent</message>
      <message name="IDS_REDROB_TASK_REPLY_PLACEHOLDER" desc="Placeholder in the task view's reply input">Reply, or send another instruction</message>
      <message name="IDS_REDROB_TASK_STEER_NOW" desc="Button that interrupts the current step with the typed reply">Steer now</message>
      <message name="IDS_REDROB_TASK_SEND_REPLY" desc="Accessible name of the send button when the task is idle">Send reply</message>
      <message name="IDS_REDROB_TASK_QUEUE_REPLY" desc="Accessible name of the send button while the task is running">Queue this for the next step</message>
      <message name="IDS_REDROB_TASK_CHOOSE_FOLDER" desc="Button that picks the folder a task may write into">Choose folder…</message>
      <message name="IDS_REDROB_TASK_NOT_FOUND" desc="Shown instead of a title when the task id in the URL is unknown">Task not found</message>
      <message name="IDS_REDROB_TASK_STATE_QUEUED" desc="Task state">queued</message>
      <message name="IDS_REDROB_TASK_STATE_RUNNING" desc="Task state">running</message>
      <message name="IDS_REDROB_TASK_STATE_BLOCKED" desc="Task state: stopped because the permission mode forbids the next step">blocked</message>
      <message name="IDS_REDROB_TASK_STATE_DONE" desc="Task state">done</message>
      <message name="IDS_REDROB_TASK_STATE_FAILED" desc="Task state">failed</message>
      <message name="IDS_REDROB_TASK_STATE_CANCELLED" desc="Task state">cancelled</message>
      <message name="IDS_REDROB_TASK_STATE_UNKNOWN" desc="Task state the page does not recognise">unknown</message>
      <message name="IDS_REDROB_TASK_JUST_NOW" desc="Relative time for something that happened under a minute ago">just now</message>
      <message name="IDS_REDROB_TASK_MINUTES_AGO" desc="Relative time in minutes"><ph name="ARG1">$1<ex>1</ex></ph>m ago</message>
      <message name="IDS_REDROB_TASK_HOURS_AGO" desc="Relative time in hours"><ph name="ARG1">$1<ex>1</ex></ph>h ago</message>
      <message name="IDS_REDROB_TASK_WORKING_SECONDS" desc="How long the running task has been working, under a minute">Working for <ph name="ARG1">$1<ex>1</ex></ph>s</message>
      <message name="IDS_REDROB_TASK_WORKING_MINUTES" desc="How long the running task has been working, over a minute">Working for <ph name="ARG1">$1<ex>1</ex></ph>m <ph name="ARG2">$2<ex>2</ex></ph>s</message>
      <message name="IDS_REDROB_TASK_CAPTURED_FRAME" desc="Alt text of a screenshot the agent took, $1 is the step's label">Captured frame: <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_LATEST_FRAME" desc="Alt text of the newest screenshot, $1 is the task's prompt">Latest frame: <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_NO_MORE_ACCESS" desc="Shown when the permission control is raised mid-task">A running task cannot be given more access. Start a new task instead.</message>
      <message name="IDS_REDROB_TASK_FILES_GO_IN" desc="Confirms the folder a task may write into">Files from this task go in "<ph name="ARG1">$1<ex>1</ex></ph>".</message>
      <message name="IDS_REDROB_TASK_NO_FOLDER_CHOSEN" desc="Shown when the folder picker was dismissed">No folder was chosen, so this task still cannot write files.</message>
      <message name="IDS_REDROB_TASK_REPLY_REJECTED" desc="Shown when a queued reply is refused">That could not be sent. There may already be too many messages waiting.</message>
      <message name="IDS_REDROB_TASK_STEERED" desc="Shown after Steer now takes effect">Interrupted — it is working on this instead.</message>
      <message name="IDS_REDROB_TASK_REPLY_QUEUED" desc="Shown after a reply is queued behind the running step">Waiting for the current step to finish.</message>
      <message name="IDS_REDROB_TASK_REPLY_SENT" desc="Shown after a reply reaches an idle task">Sent.</message>
      <message name="IDS_REDROB_TASK_ENGINE_UNAVAILABLE" desc="Shown when the sidecar is not running">Could not start the task: the Redrob Code engine is not available.</message>
      <message name="IDS_REDROB_TASK_COMMAND_UNAVAILABLE" desc="Shown when a slash command cannot reach the sidecar">That command could not be run: the Redrob Code engine is not available.</message>
      <message name="IDS_REDROB_TASK_NOT_FOUND_DETAIL" desc="Explains a task id that no longer resolves">It may have been cleared, or the link may be from another profile. Nothing was lost from the tasks you still have.</message>
      <message name="IDS_REDROB_TASK_BACK_HOME_LABEL" desc="Label of the action offered when a task is not found">Go to the new tab</message>
      <message name="IDS_REDROB_TASK_QUEUED_MESSAGE" desc="Trace line recorded when a follow-up is queued; $1 is what the user typed">Queued: <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_WITHDREW_QUEUED" desc="Trace line recorded when a queued follow-up is taken back; $1 is what the user typed">Withdrawn: <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_WITHDRAW_QUEUED" desc="Accessible name of the button that takes back one queued message">Withdraw</message>
      <message name="IDS_REDROB_TASK_WITHDRAW_FAILED" desc="Shown when withdrawing fails because the queue moved on">That message has already run.</message>
      <message name="IDS_REDROB_NEW_TAB_MODEL_DEFAULT" desc="The only model option when no engine is available to list others">Default model</message>
      <message name="IDS_REDROB_TASK_ENGINE_STOPPED" desc="Task error when the engine died mid-run">The Redrob Code engine stopped responding.</message>
      <message name="IDS_REDROB_TASK_ENGINE_TOO_OLD" desc="Task error when the engine does not implement the chat-completions contract this browser needs">This browser needs a newer Redrob Code engine. Update it, then start the task again.</message>
      <message name="IDS_REDROB_TASK_ENGINE_CREDENTIAL" desc="Task error when the engine rejects the per-launch credential">The Redrob Code engine refused this browser's credential.</message>
      <message name="IDS_REDROB_TASK_ENGINE_NO_ANSWER" desc="Task error when a turn completes with no text and no tool call">The engine ended the task without producing an answer.</message>
      <message name="IDS_REDROB_TASK_NEEDS_CONFIRMATION" desc="Trace line when a guard-mode task asks before a send, post, pay or delete click; $1 is the control's text">Waiting for you: press "<ph name="ARG1">$1<ex>1</ex></ph>"?</message>
      <message name="IDS_REDROB_TASK_CONFIRMATION_DECLINED" desc="Trace line after the user declines a guarded click; $1 is the control's text">You declined: "<ph name="ARG1">$1<ex>1</ex></ph>"</message>
      <message name="IDS_REDROB_TASK_NOTIFY_NEEDS_YOU" desc="OS notification title when a task waits for a confirmation; $1 is the task's prompt">Task needs you: <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_NOTIFY_NEEDS_YOU_BODY" desc="OS notification body for a guarded click; $1 is the control's text">The agent wants to press "<ph name="ARG1">$1<ex>1</ex></ph>". Allow it?</message>
      <message name="IDS_REDROB_TASK_NOTIFY_ALLOW" desc="Notification button that lets the guarded click run">Allow</message>
      <message name="IDS_REDROB_TASK_NOTIFY_DECLINE" desc="Notification button that refuses the guarded click">Decline</message>
      <message name="IDS_REDROB_TASK_NOTIFY_DONE" desc="OS notification title when a task finishes with no browser window open; $1 is the task's prompt">Task done: <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_NOTIFY_FAILED" desc="OS notification title when a task fails with no browser window open; $1 is the task's prompt">Task stopped: <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_NOTIFY_OPEN" desc="OS notification body for a finished task">Click to see what it did.</message>
      <message name="IDS_REDROB_TASK_NOTIFY_SOURCE" desc="Source line of a task notification">Redrob tasks</message>
      <message name="IDS_REDROB_TASK_TURN_IDLE" desc="Task error when a non-Ultrabrowse turn streams nothing for several minutes">The engine went silent in the middle of a step, so the task was stopped. Try again, or choose Ultrabrowse for long work.</message>
      <message name="IDS_REDROB_ENGINE_ACCOUNT_UNREACHABLE" desc="Settings error when the engine cannot be asked about providers">The Redrob engine is not running yet. Try again in a moment.</message>
      <message name="IDS_REDROB_ENGINE_ACCOUNT_REFUSED" desc="Settings error when the engine answers an account request with an error and no reason; $1 is the HTTP status">The engine refused the request (status <ph name="ARG1">$1<ex>1</ex></ph>).</message>
      <message name="IDS_REDROB_ENGINE_SIGN_IN_NO_PAGE" desc="Settings error when an OAuth sign-in has no authorize URL">The engine did not return a sign-in page for that provider.</message>
      <message name="IDS_REDROB_ENGINE_SIGN_IN_FAILED" desc="Settings error when the engine reports the OAuth callback failed">The sign-in did not complete. Try again.</message>
      <message name="IDS_REDROB_OB_WELCOME_TITLE" desc="Heading of the first step">Welcome to Redrob</message>
      <message name="IDS_REDROB_OB_WELCOME_BODY" desc="Body of the first step">A browser that can do the work, not just show you the page.</message>
      <message name="IDS_REDROB_OB_ACCOUNT_TITLE" desc="Heading of the account step, which explains the account rather than creating one">What a Redrob account is for</message>
      <message name="IDS_REDROB_OB_ACCOUNT_BODY" desc="Body of the account step">Your tasks, memory and routines follow the account, not the machine.</message>
      <message name="IDS_REDROB_OB_EMAIL_LABEL" desc="Accessible name of the email field">Email address</message>
      <message name="IDS_REDROB_OB_HAVE_ACCOUNT" desc="Button for a returning user">I already have an account</message>
      <message name="IDS_REDROB_OB_AGENT_TITLE" desc="Heading of the agent step">Hand the browser a task</message>
      <message name="IDS_REDROB_OB_AGENT_BODY" desc="Body of the agent step">Ask for an outcome and Redrob works in real tabs you can watch, take over, or close.</message>
      <message name="IDS_REDROB_OB_AGENT_SHORTCUT_BEFORE" desc="Leads the keyboard shortcut hint, before the key names">Press</message>
      <message name="IDS_REDROB_OB_AGENT_SHORTCUT_AFTER" desc="Follows the key names in the keyboard shortcut hint">anywhere to ask about what you are looking at.</message>
      <message name="IDS_REDROB_OB_PASSWORDS_TITLE" desc="Heading of the passwords step">Signing in to sites</message>
      <message name="IDS_REDROB_OB_PASSWORDS_BODY" desc="Body of the passwords step">An agent is most useful on sites you are already signed in to. Passwords are filled by the browser and are never shown to the model.</message>
      <message name="IDS_REDROB_OB_PASSWORDS_GROUP" desc="Accessible name of the password choices">Password manager</message>
      <message name="IDS_REDROB_OB_PASSWORDS_USE_REDROB" desc="Choice: keep passwords in this browser">Use Redrob's password manager</message>
      <message name="IDS_REDROB_OB_PASSWORDS_USE_REDROB_DETAIL" desc="Detail of that choice">Bring saved logins in from another browser.</message>
      <message name="IDS_REDROB_OB_PASSWORDS_EXTERNAL" desc="Choice: keep an external password manager">Connect the one I use</message>
      <message name="IDS_REDROB_OB_PASSWORDS_EXTERNAL_DETAIL" desc="Detail of that choice">Keep your current manager and let it fill.</message>
      <message name="IDS_REDROB_OB_PASSWORDS_SKIP" desc="Choice: decide later">Skip for now</message>
      <message name="IDS_REDROB_OB_PASSWORDS_SKIP_DETAIL" desc="Detail of that choice">Set this up later in Settings.</message>
      <message name="IDS_REDROB_OB_MODEL_TITLE" desc="Heading of the model step">Choose what thinks for you</message>
      <message name="IDS_REDROB_OB_MODEL_BODY" desc="Body of the model step">Use the models included with Redrob, or bring a subscription you already pay for.</message>
      <message name="IDS_REDROB_OB_MODEL_GROUP" desc="Accessible name of the provider choices">Model provider</message>
      <message name="IDS_REDROB_OB_MODEL_REDROB" desc="Choice: the built-in engine">Redrob</message>
      <message name="IDS_REDROB_OB_MODEL_REDROB_DETAIL" desc="Detail of that choice">Included with your plan.</message>
      <message name="IDS_REDROB_OB_MODEL_CHATGPT" desc="Choice: an OpenAI subscription">ChatGPT</message>
      <message name="IDS_REDROB_OB_MODEL_CHATGPT_DETAIL" desc="Detail of that choice">Connect a Plus or Pro subscription.</message>
      <message name="IDS_REDROB_OB_MODEL_CLAUDE" desc="Choice: an Anthropic subscription">Claude</message>
      <message name="IDS_REDROB_OB_MODEL_CLAUDE_DETAIL" desc="Detail of that choice">Connect a Pro or Max subscription.</message>
      <message name="IDS_REDROB_OB_MORE_PROVIDERS" desc="Button that reveals the remaining providers">Show more options</message>
      <message name="IDS_REDROB_OB_IMPORT_TITLE" desc="Heading of the import step">Bring your browser with you</message>
      <message name="IDS_REDROB_OB_IMPORT_BODY" desc="Body of the import step">Bookmarks, history and saved passwords can come across.</message>
      <message name="IDS_REDROB_OB_IMPORT_GROUP" desc="Accessible name of the import choices">Import source</message>
      <message name="IDS_REDROB_OB_IMPORT_CHOOSE_SOURCE" desc="Body of the import step once sources were found">Choose where to bring your data from.</message>
      <message name="IDS_REDROB_OB_IMPORT_NOTHING_FOUND" desc="Shown when no other browser is installed">No other browser with importable data was found on this computer.</message>
      <message name="IDS_REDROB_OB_IMPORT_NOTHING_READABLE" desc="Listed against a source whose data cannot be read">nothing this browser can read</message>
      <message name="IDS_REDROB_OB_IMPORT_SAVED_PASSWORDS" desc="One of the data kinds a source offers">saved passwords</message>
      <message name="IDS_REDROB_OB_IMPORT_SEARCH_ENGINES" desc="One of the data kinds a source offers">search engines</message>
      <message name="IDS_REDROB_OB_IMPORT_SIGNED_IN_SESSIONS" desc="One of the data kinds a source offers">signed-in sessions</message>
      <message name="IDS_REDROB_OB_IMPORT_SOURCE_BUSY" desc="Shown when the source browser is running">Close the other browser and try the import again.</message>
      <message name="IDS_REDROB_OB_IMPORT_FAILED" desc="Shown when the import fails for an unnamed reason">The import did not finish.</message>
      <message name="IDS_REDROB_OB_BACK" desc="Button that returns to the previous step">Back</message>
      <message name="IDS_REDROB_OB_PROGRESS" desc="Accessible name of the step dots">Setup progress</message>
      <message name="IDS_REDROB_OB_CONTINUE" desc="Button that advances to the next step">Continue</message>
      <message name="IDS_REDROB_OB_IMPORT" desc="Button that starts the import">Import</message>
      <message name="IDS_REDROB_OB_FINISH" desc="Button that closes the first-run flow">Finish</message>
      <message name="IDS_REDROB_OB_TRY_AGAIN" desc="Button shown after a step failed">Try again</message>
      <message name="IDS_REDROB_OB_SHORTCUT_COMMAND" desc="Name of the macOS modifier key">Command</message>
      <message name="IDS_REDROB_OB_SHORTCUT_CTRL" desc="Name of the Windows and Linux modifier key">Ctrl</message>
      <message name="IDS_REDROB_OB_STEP_OF" desc="Accessible name of one progress dot; $1 is this step number, $2 is the total">Step <ph name="ARG1">$1<ex>1</ex></ph> of <ph name="ARG2">$2<ex>2</ex></ph></message>
      <message name="IDS_REDROB_OB_IMPORT_RUNNING" desc="Shown while a browser import is running">Importing…</message>
      <message name="IDS_REDROB_OB_IMPORT_DONE" desc="Shown when a browser import finished">Imported.</message>
      <message name="IDS_REDROB_SE_DOCUMENT_TITLE" desc="Title of the settings page">Redrob settings</message>
      <message name="IDS_REDROB_SE_NAV" desc="Accessible name of the settings navigation">Settings sections</message>
      <message name="IDS_REDROB_SE_NAV_ROUTINES" desc="Navigation link to the routines section">Routines</message>
      <message name="IDS_REDROB_SE_NAV_MEMORY" desc="Navigation link to the memory section">Memory</message>
      <message name="IDS_REDROB_SE_NAV_MODELS" desc="Navigation link to the models section">Models</message>
      <message name="IDS_REDROB_SE_NAV_PASSWORDS" desc="Navigation link to the passwords section">Passwords</message>
      <message name="IDS_REDROB_SE_NAV_CLI" desc="Navigation link to the automation section">Command line</message>
      <message name="IDS_REDROB_SE_NAV_FILES" desc="Navigation link to the files section">Files</message>
      <message name="IDS_REDROB_SE_NAV_BROWSER_SETTINGS" desc="Navigation link out to the browser's own settings">Browser settings</message>
      <message name="IDS_REDROB_SE_ROUTINES_EMPTY" desc="Shown when the user has no routines">No routines yet.</message>
      <message name="IDS_REDROB_SE_ROUTINE_NEW" desc="Heading of the add-a-routine form">New routine</message>
      <message name="IDS_REDROB_SE_ROUTINE_NAME" desc="Label of the routine's name field">Name</message>
      <message name="IDS_REDROB_SE_ROUTINE_NAME_PLACEHOLDER" desc="Example routine name">Morning news check</message>
      <message name="IDS_REDROB_SE_ROUTINE_WHAT" desc="Label of the routine's instruction field">What it should do</message>
      <message name="IDS_REDROB_SE_ROUTINE_WHAT_PLACEHOLDER" desc="Example routine instruction">Check the three sites I follow and tell me what changed since yesterday.</message>
      <message name="IDS_REDROB_SE_ROUTINE_KIND" desc="Label of the routine kind picker">Kind</message>
      <message name="IDS_REDROB_SE_ROUTINE_KIND_CRON" desc="Routine kind: a fresh task each time">Start a new task</message>
      <message name="IDS_REDROB_SE_ROUTINE_KIND_HEARTBEAT" desc="Routine kind: continue one chat">Wake an existing chat</message>
      <message name="IDS_REDROB_SE_ROUTINE_WHICH_CHAT" desc="Label of the chat picker for a heartbeat routine">Which chat</message>
      <message name="IDS_REDROB_SE_ROUTINE_EVERY" desc="Label of the routine interval picker">Every</message>
      <message name="IDS_REDROB_SE_ROUTINE_EVERY_HOUR" desc="Routine interval">hour</message>
      <message name="IDS_REDROB_SE_ROUTINE_EVERY4_HOURS" desc="Routine interval">4 hours</message>
      <message name="IDS_REDROB_SE_ROUTINE_EVERY12_HOURS" desc="Routine interval">12 hours</message>
      <message name="IDS_REDROB_SE_ROUTINE_EVERY_DAY" desc="Routine interval">day</message>
      <message name="IDS_REDROB_SE_ROUTINE_EVERY_WEEK" desc="Routine interval">week</message>
      <message name="IDS_REDROB_SE_ROUTINE_PERMISSION" desc="Label of the routine permission picker">Permission</message>
      <message name="IDS_REDROB_SE_ROUTINE_ADD" desc="Button that saves the new routine">Add routine</message>
      <message name="IDS_REDROB_SE_ROUTINE_NOTE" desc="Explains the limits routines run under">Routines run at most every 10 minutes, are skipped rather than queued when four tasks are already running, and a routine that came due while the browser was closed runs once — not once per interval missed.</message>
      <message name="IDS_REDROB_SE_ROUTINE_RUN_NOW" desc="Button that runs a routine immediately">Run now</message>
      <message name="IDS_REDROB_SE_ROUTINE_PAUSE" desc="Button that stops a routine from firing">Pause</message>
      <message name="IDS_REDROB_SE_ROUTINE_RESUME" desc="Button that lets a routine fire again">Resume</message>
      <message name="IDS_REDROB_SE_ROUTINE_DELETE" desc="Button that removes a routine">Delete</message>
      <message name="IDS_REDROB_SE_ROUTINE_STARTED" desc="Shown after Run now succeeds">Started. It is in Chats.</message>
      <message name="IDS_REDROB_SE_ROUTINE_NOT_STARTED" desc="Shown after Run now fails">Not started — check the reason on the routine.</message>
      <message name="IDS_REDROB_SE_ROUTINE_NEEDS_PROMPT" desc="Shown when the instruction field is empty">A routine needs something to do.</message>
      <message name="IDS_REDROB_SE_ROUTINE_NEEDS_CHAT" desc="Shown when a heartbeat routine has no chat to attach to">There is no chat to wake yet. Start a task first, then point a heartbeat at it.</message>
      <message name="IDS_REDROB_SE_ROUTINE_ADD_FAILED" desc="Shown when saving a routine fails">That could not be added.</message>
      <message name="IDS_REDROB_SE_ROUTINE_KIND_WAKES" desc="Describes a heartbeat routine in its row">wakes a chat</message>
      <message name="IDS_REDROB_SE_ROUTINE_KIND_NEW" desc="Describes a schedule routine in its row">new task</message>
      <message name="IDS_REDROB_SE_EVERY_DAY" desc="How often a routine runs">every day</message>
      <message name="IDS_REDROB_SE_EVERY_WEEK" desc="How often a routine runs">every week</message>
      <message name="IDS_REDROB_SE_EVERY_DAYS" desc="How often a routine runs">every <ph name="ARG1">$1<ex>1</ex></ph> days</message>
      <message name="IDS_REDROB_SE_EVERY_HOUR" desc="How often a routine runs">every hour</message>
      <message name="IDS_REDROB_SE_EVERY_HOURS" desc="How often a routine runs">every <ph name="ARG1">$1<ex>1</ex></ph> hours</message>
      <message name="IDS_REDROB_SE_IN_UNDER_A_MINUTE" desc="When something will next happen">in under a minute</message>
      <message name="IDS_REDROB_SE_MEMORY_LEDE" desc="Explains what memory is">What the agent may carry from one task to the next. Nothing is remembered unless a task explicitly stored it, and every entry shows the task it came from.</message>
      <message name="IDS_REDROB_SE_MEMORY_ENABLED" desc="Toggle that turns memory on">Let tasks remember things</message>
      <message name="IDS_REDROB_SE_MEMORY_RETENTION" desc="Label of the retention picker">Keep entries for</message>
      <message name="IDS_REDROB_SE_MEMORY30_DAYS" desc="Retention period">30 days</message>
      <message name="IDS_REDROB_SE_MEMORY90_DAYS" desc="Retention period">90 days</message>
      <message name="IDS_REDROB_SE_MEMORY_FOREVER" desc="Retention period: keep entries indefinitely">Until I delete them</message>
      <message name="IDS_REDROB_SE_MEMORY_FORGET" desc="Button that deletes every memory entry">Forget everything</message>
      <message name="IDS_REDROB_SE_MEMORY_EMPTY" desc="Shown when memory is empty">Nothing remembered yet.</message>
      <message name="IDS_REDROB_SE_MEMORY_TRIMMED" desc="Shown after shortening the retention period">Older entries were removed straight away.</message>
      <message name="IDS_REDROB_SE_MEMORY_CLEARED" desc="Shown after Forget everything">Everything was deleted, pinned entries included.</message>
      <message name="IDS_REDROB_SE_MEMORY_PIN" desc="Button that keeps a memory entry past its retention">Pin</message>
      <message name="IDS_REDROB_SE_MEMORY_UNPIN" desc="Button that stops keeping a memory entry">Unpin</message>
      <message name="IDS_REDROB_SE_MODELS_LEDE" desc="Explains the models section">Which model answers your tasks. The built-in engine needs no setup. Your own provider needs a key, which is stored through this machine's keystore and is never shown again — not to this page, and not to any page.</message>
      <message name="IDS_REDROB_SE_SIGNIN_HEADING" desc="Heading of the OAuth sign-in form">Sign in to a provider</message>
      <message name="IDS_REDROB_SE_SIGNIN_NAME_PLACEHOLDER" desc="Example connection name">My ChatGPT account</message>
      <message name="IDS_REDROB_SE_SIGNIN_ENDPOINT_LABEL" desc="Label of the OAuth provider's API endpoint">API endpoint</message>
      <message name="IDS_REDROB_SE_SIGNIN_AUTHORIZE_URL" desc="Label of the OAuth authorize endpoint">Authorize URL</message>
      <message name="IDS_REDROB_SE_SIGNIN_TOKEN_URL" desc="Label of the OAuth token endpoint">Token URL</message>
      <message name="IDS_REDROB_SE_SIGNIN_CLIENT_ID" desc="Label of the OAuth client id">Client ID</message>
      <message name="IDS_REDROB_SE_SIGNIN_CLIENT_PLACEHOLDER" desc="Example client id">your own registered OAuth client</message>
      <message name="IDS_REDROB_SE_SIGNIN_SCOPES" desc="Label of the OAuth scopes field">Scopes</message>
      <message name="IDS_REDROB_SE_SIGNIN_SUBMIT" desc="Button that starts the OAuth flow">Sign in…</message>
      <message name="IDS_REDROB_SE_SIGNIN_NOTE" desc="Explains what the sign-in flow does">Opens the provider's own sign-in page in a tab. The browser keeps the tokens encrypted through this machine's keystore and renews them when they expire; nothing is readable back by this page.</message>
      <message name="IDS_REDROB_SE_PROVIDER_HEADING" desc="Heading of the API-key form">Connect a provider</message>
      <message name="IDS_REDROB_SE_PROVIDER_NAME_PLACEHOLDER" desc="Example connection name">My OpenAI account</message>
      <message name="IDS_REDROB_SE_PROVIDER_ENDPOINT" desc="Label of the API endpoint field">Endpoint</message>
      <message name="IDS_REDROB_SE_PROVIDER_API_KEY" desc="Label of the API key field">API key</message>
      <message name="IDS_REDROB_SE_PROVIDER_SECRET_PLACEHOLDER" desc="Placeholder in the API key field">Stored encrypted; never displayed again</message>
      <message name="IDS_REDROB_SE_PROVIDER_CONNECT" desc="Button that saves the provider">Connect</message>
      <message name="IDS_REDROB_SE_PROVIDER_NOTE" desc="Explains the constraints on a connected provider">Must be an https endpoint that speaks the OpenAI chat-completions shape. Tasks you run against your own provider send that provider the pages they read.</message>
      <message name="IDS_REDROB_SE_PROVIDER_REDROB_ENGINE" desc="Name of the built-in model connection">Redrob engine</message>
      <message name="IDS_REDROB_SE_PROVIDER_NO_KEY_NEEDED" desc="Describes the built-in engine">runs on this machine · no key needed</message>
      <message name="IDS_REDROB_SE_PROVIDER_OAUTH_OK" desc="Describes a provider connected by OAuth">signed in, renews itself</message>
      <message name="IDS_REDROB_SE_PROVIDER_KEY_STORED" desc="Describes a provider connected by API key">key stored</message>
      <message name="IDS_REDROB_SE_PROVIDER_NO_KEY" desc="Describes a provider with no credential">no key</message>
      <message name="IDS_REDROB_SE_PROVIDER_IN_USE" desc="Marks the model currently answering tasks">In use</message>
      <message name="IDS_REDROB_SE_PROVIDER_USE" desc="Button that switches to this model">Use</message>
      <message name="IDS_REDROB_SE_PROVIDER_REMOVE" desc="Button that deletes a provider connection">Remove</message>
      <message name="IDS_REDROB_SE_KEYSTORE_NOT_READY" desc="Shown when os_crypt is not ready">This machine’s keystore has not answered yet, so a key cannot be stored safely. Try again in a moment.</message>
      <message name="IDS_REDROB_SE_PROVIDER_SAVE_FAILED" desc="Shown when the provider form is rejected">That could not be saved. The endpoint must be https, and the name, model and key are all required.</message>
      <message name="IDS_REDROB_SE_PROVIDER_CONNECTED" desc="Shown after a provider is saved">Connected. The key is stored encrypted and cannot be read back.</message>
      <message name="IDS_REDROB_SE_SIGNIN_DONE" desc="Shown after OAuth succeeds">Signed in.</message>
      <message name="IDS_REDROB_SE_SIGNIN_NOT_DONE" desc="Shown after OAuth fails">Still not signed in. If the provider showed an error, it was theirs — check the client ID.</message>
      <message name="IDS_REDROB_SE_SIGNIN_WAITING" desc="Shown while the OAuth tab is open">Waiting for you to finish signing in, in the tab that just opened…</message>
      <message name="IDS_REDROB_SE_PASSWORDS_LEDE" desc="Explains the passwords section">Logged-in sites are where the agent is most useful, so how passwords are handled matters here. The credentials themselves live in this browser's own password manager — this page decides whether it offers to save them.</message>
      <message name="IDS_REDROB_SE_PASSWORDS_USE_REDROB" desc="Choice: keep passwords in this browser">Use Redrob's manager</message>
      <message name="IDS_REDROB_SE_PASSWORDS_USE_REDROB_DETAIL" desc="Detail of that choice">Save and fill passwords in this browser.</message>
      <message name="IDS_REDROB_SE_PASSWORDS_EXTERNAL" desc="Choice: an external password manager">I use another manager</message>
      <message name="IDS_REDROB_SE_PASSWORDS_EXTERNAL_DETAIL" desc="Detail of that choice">Stop offering to save. Passwords already saved here stay saved and can still be filled — nothing is migrated or deleted.</message>
      <message name="IDS_REDROB_SE_PASSWORDS_LATER" desc="Choice: leave the setting alone">Decide later</message>
      <message name="IDS_REDROB_SE_PASSWORDS_LATER_DETAIL" desc="Detail of that choice">Leave it as it is.</message>
      <message name="IDS_REDROB_SE_PASSWORDS_OFFER_TO_SAVE" desc="Toggle that controls the save prompt">Offer to save passwords</message>
      <message name="IDS_REDROB_SE_PASSWORDS_AUTO_SIGNIN" desc="Toggle that controls automatic sign-in">Sign in automatically where I have saved a password</message>
      <message name="IDS_REDROB_SE_PASSWORDS_OPEN_MANAGER" desc="Button that opens the browser's password manager">Open password manager</message>
      <message name="IDS_REDROB_SE_PASSWORDS_SAVING_OFF" desc="Shown after switching to an external manager">Saving is off. Passwords already saved here are still there and can still be filled.</message>
      <message name="IDS_REDROB_SE_CLI_HEADING" desc="Heading of the automation section">Command line, MCP and scripts</message>
      <message name="IDS_REDROB_SE_CLI_LEDE" desc="Explains the automation section">Two ways to drive this browser from outside it. One needs no setup; the other is a local socket, and it is off until you turn it on.</message>
      <message name="IDS_REDROB_SE_CLI_NO_SETUP_HEADING" desc="Heading of the command-line subsection">From a terminal, with no setup</message>
      <message name="IDS_REDROB_SE_CLI_NO_SETUP_NOTE" desc="Explains why the command line prints nothing">Starts the task in the browser you already have running and opens its tab. Nothing is printed back: the channel that carries a command line to a running browser answers with an acknowledgement and no payload, so there is no output and no exit code to read. That is the channel's shape, not a missing feature — use the endpoint below when the answer has to come back to the terminal.</message>
      <message name="IDS_REDROB_SE_CLI_ENDPOINT_HEADING" desc="Heading of the local RPC subsection">Local endpoint</message>
      <message name="IDS_REDROB_SE_CLI_RPC_ENABLED" desc="Toggle that starts the local RPC server">Let local programs drive this browser</message>
      <message name="IDS_REDROB_SE_CLI_LISTENING_ON" desc="Precedes the address the RPC server is bound to">Listening on</message>
      <message name="IDS_REDROB_SE_CLI_NOTHING" desc="Shown in place of an address when the RPC server is off">nothing</message>
      <message name="IDS_REDROB_SE_CLI_RPC_WARN" desc="Warns about the risk of the local endpoint">Off by default on purpose. Any program on this machine that can read that file can then do anything you can do in this browser, including on sites you are signed in to. Turn it on when you have a reason to, and turn it off after.</message>
      <message name="IDS_REDROB_SE_CLI_LISTENING_AT" desc="Shown when the RPC server binds successfully">Listening on <ph name="ARG1">$1<ex>1</ex></ph>.</message>
      <message name="IDS_REDROB_SE_CLI_BIND_FAILED" desc="Shown when the RPC server cannot start">The socket could not be bound, so nothing is listening.</message>
      <message name="IDS_REDROB_SE_CLI_STOPPED" desc="Shown after the RPC server is turned off">Stopped listening, and the token file is gone.</message>
      <message name="IDS_REDROB_SE_FILES_LEDE" desc="Explains the files section">Where tasks write. A task with no folder refuses to write rather than picking somewhere for you.</message>
      <message name="IDS_REDROB_SE_FILES_CURRENT_FOLDER" desc="Precedes the folder tasks may write into">Current folder:</message>
      <message name="IDS_REDROB_SE_FILES_NONE" desc="Shown in place of a folder when none is chosen">none</message>
      <message name="IDS_REDROB_SE_FILES_CLEAR" desc="Button that unsets the folder">Clear</message>
      <message name="IDS_REDROB_SE_FILES_NOTE" desc="Explains the writes that are refused regardless">Even in Full access, the browser refuses to write into hidden folders, into its own profile directory, and over a file that already exists.</message>
      <message name="IDS_REDROB_SE_FILES_NO_FOLDER_CHOSEN" desc="Shown when the folder picker was dismissed or unavailable">No folder was chosen. On Linux this needs a desktop file-chooser to be available.</message>
      <message name="IDS_REDROB_SE_CLI_EXAMPLE" desc="The example command line; the quoted part is what a user would actually type">redrob-browser --redrob-task="summarise the page I have open"</message>
      <message name="IDS_REDROB_SE_ROUTINES_LEDE" desc="Explains the routines section. Carries its own &lt;strong&gt; markup so a translation can place it">Tasks the browser starts on its own. A &lt;strong&gt;schedule&lt;/strong&gt; starts a new task each time; a &lt;strong&gt;heartbeat&lt;/strong&gt; wakes one of your existing chats with its context intact.</message>
      <message name="IDS_REDROB_SE_SIGNIN_CLIENT_WARN" desc="Warns that a third-party OAuth client id will be refused. Carries its own &lt;strong&gt; markup">&lt;strong&gt;The client ID has to be your own.&lt;/strong&gt; Two things are worth knowing before you try someone else’s. Anthropic prohibited subscription sign-in outside Claude Code in February 2026 and rejects those tokens at the server, so a Claude subscription cannot be connected here at all — use an API key above, which works. OpenAI does allow ChatGPT subscription sign-in in third-party tools and its endpoints are public, but a client ID that is not their own first-party one is refused at the token endpoint. If that happens you will see the provider’s own error, not ours.</message>
      <message name="IDS_REDROB_SE_CLI_RPC_NOTE" desc="Explains what the local endpoint serves. Carries its own &lt;span&gt; markup">Serves three things: an HTTP endpoint that can stream a task’s answer back to a script, an MCP server at &lt;span class="mono"&gt;POST /mcp&lt;/span&gt; so another agent — Redrob Code included — can call this browser as a tool, and the same verbs one at a time. Loopback only, on a port the system picks, and every request needs a token generated fresh each launch — programs read the address and the token from &lt;span class="mono" id="rpc-handle"&gt;redrob-cli.json&lt;/span&gt; in this profile’s folder. See docs/AUTOMATION.md.</message>
      <message name="IDS_REDROB_SE_NAV_GETTING_STARTED" desc="Navigation link to the getting-started section">Getting started</message>
      <message name="IDS_REDROB_SE_ONBOARDING_LEDE" desc="Explains the getting-started section">The short tour this browser showed when it first opened. It only explains things — nothing you do in it changes a setting, so it is safe to reopen whenever.</message>
      <message name="IDS_REDROB_SE_ONBOARDING_OPEN" desc="Button that opens the onboarding page in a tab">Open the tour</message>
      <message name="IDS_REDROB_SE_KEYSTORE_NOT_ANSWERED" desc="Error when a provider is added before the OS keystore is ready">This machine's keystore has not answered yet.</message>
      <message name="IDS_REDROB_SE_SIGNIN_FIELDS_REQUIRED" desc="Error when the sign-in form is incomplete">A name, a model and a valid endpoint are all required.</message>
      <message name="IDS_REDROB_SE_TOO_MANY_PROVIDERS" desc="Error when the provider limit is reached">There are already too many providers.</message>
      <message name="IDS_REDROB_SE_ROUTINE_ENGINE_UNAVAILABLE" desc="Recorded on a routine whose run could not reach the engine">The task engine was not available.</message>
      <message name="IDS_REDROB_SE_ROUTINE_CHAT_GONE" desc="Recorded on a heartbeat routine whose chat was deleted">That chat no longer exists, so there was nothing to wake.</message>
      <message name="IDS_REDROB_SE_CONFIRM_CANCEL" desc="Button that dismisses a confirmation without acting">Cancel</message>
      <message name="IDS_REDROB_SE_FORGET_TITLE" desc="Title of the confirmation before all memory is deleted">Forget everything?</message>
      <message name="IDS_REDROB_SE_FORGET_BODY" desc="Body of the confirmation before all memory is deleted">Every entry goes, pinned ones included. This cannot be undone.</message>
      <message name="IDS_REDROB_SE_REMOVE_PROVIDER_TITLE" desc="Title of the confirmation before a provider is deleted; $1 is the provider's name">Remove <ph name="ARG1">$1<ex>1</ex></ph>?</message>
      <message name="IDS_REDROB_SE_REMOVE_PROVIDER_BODY" desc="Body of the confirmation before a provider is deleted">Its stored key goes with it. You will need the key again to reconnect.</message>
      <message name="IDS_REDROB_SE_DELETE_ROUTINE_TITLE" desc="Title of the confirmation before a routine is deleted; $1 is the routine's name">Delete “<ph name="ARG1">$1<ex>1</ex></ph>”?</message>
      <message name="IDS_REDROB_SE_DELETE_ROUTINE_BODY" desc="Body of the confirmation before a routine is deleted">It stops running and its schedule is gone. This cannot be undone.</message>
      <message name="IDS_REDROB_SE_MEMORY_SEARCH" desc="Placeholder of the input that filters the memory list">Search what it remembers</message>
      <message name="IDS_REDROB_SE_MEMORY_SHOWING" desc="Count above the memory list while a search is filtering it"><ph name="ARG1">$1<ex>1</ex></ph> of <ph name="ARG2">$2<ex>2</ex></ph> shown</message>
      <message name="IDS_REDROB_SE_MEMORY_NO_MATCH" desc="Shown when a memory search filters everything out">Nothing matches that.</message>
      <message name="IDS_REDROB_SE_ROUTINE_ADDED" desc="Shown after a routine is added">Added.</message>
      <message name="IDS_REDROB_SE_ROUTINE_EDIT" desc="Button that loads a routine into the form for editing">Edit</message>
      <message name="IDS_REDROB_SE_ROUTINE_EDITING" desc="Heading of the routine form while an existing routine is being edited">Editing “<ph name="ARG1">$1<ex>1</ex></ph>”</message>
      <message name="IDS_REDROB_SE_ROUTINE_SAVE" desc="Button that saves an edited routine">Save changes</message>
      <message name="IDS_REDROB_SE_ROUTINE_UPDATED" desc="Shown after an edited routine is saved">Saved.</message>
      <message name="IDS_REDROB_SE_ROUTINE_UPDATE_FAILED" desc="Shown when saving an edited routine fails">That could not be saved.</message>
      <message name="IDS_REDROB_SE_NAV_APPEARANCE" desc="Settings nav entry for the appearance section">Appearance</message>
      <message name="IDS_REDROB_SE_APPEARANCE_LEDE" desc="Lede explaining why appearance is not configured on this page">Theme and language are browser-wide settings, so they live in the browser's own settings and apply to every Redrob surface.</message>
      <message name="IDS_REDROB_SE_APPEARANCE_THEME" desc="Label of the theme row in the appearance section">Light, dark, or follow the system</message>
      <message name="IDS_REDROB_SE_APPEARANCE_OPEN_THEME" desc="Button that opens the browser's appearance settings page">Open appearance settings</message>
      <message name="IDS_REDROB_SE_APPEARANCE_THEME_NOTE" desc="Note under the theme row">This page and the new tab follow whichever mode is chosen there.</message>
      <message name="IDS_REDROB_SE_APPEARANCE_LANGUAGE" desc="Label of the language row in the appearance section">Interface language</message>
      <message name="IDS_REDROB_SE_APPEARANCE_OPEN_LANGUAGE" desc="Button that opens the browser's language settings page">Open language settings</message>
      <message name="IDS_REDROB_SE_APPEARANCE_LANGUAGE_NOTE" desc="Note under the language row">Changing the language takes effect after the browser restarts.</message>
      <message name="IDS_REDROB_SE_ENGINE_READY" desc="Built-in engine state: serving">Running</message>
      <message name="IDS_REDROB_SE_ENGINE_STARTING" desc="Built-in engine state: launched but not answering yet">Starting up</message>
      <message name="IDS_REDROB_SE_ENGINE_FAILED" desc="Built-in engine state: was running and broke">Stopped responding</message>
      <message name="IDS_REDROB_SE_ENGINE_NOT_INSTALLED" desc="Built-in engine state: no engine binary was found anywhere">Not installed, so tasks cannot run</message>
      <message name="IDS_REDROB_SE_ENGINE_MODEL_COUNT" desc="How many models the engine reported; $1 is the count"><ph name="ARG1">$1<ex>1</ex></ph> models</message>
      <message name="IDS_REDROB_TASK_MEMORY_RECALLED" desc="Trace line at the start of a task; $1 is how many lines of the memory files matched its prompt">Recalled <ph name="ARG1">$1<ex>1</ex></ph> lines from memory</message>
      <message name="IDS_REDROB_TASK_MEMORY_READ" desc="Trace line when the agent reads a memory file; $1 is the file's path, e.g. USER.md">Read <ph name="ARG1">$1<ex>1</ex></ph> from memory</message>
      <message name="IDS_REDROB_TASK_MEMORY_WRITE_REFUSED" desc="Trace line when an ordinary task tries to change a memory file">Refused: memory is written after the task, not during it</message>
      <message name="IDS_REDROB_SE_ROUTINE_CONSOLIDATE_TITLE" desc="Title of the built-in routine that reviews the memory files once a day">Memory consolidation</message>
      <message name="IDS_REDROB_SE_ROUTINE_CONSOLIDATE_NOT_DUE" desc="Why the built-in memory consolidation routine did not run this time">Skipped: fewer than three new memory runs since the last one, or it ran within the last day.</message>
      <message name="IDS_REDROB_AGENT_CREDENTIALS_UNLOCK_PROMPT" desc="Reason shown in the OS re-authentication dialog when the user unlocks agent sign-in">let the agent sign in with your saved passwords</message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_SIGNED_IN" desc="Trace line when the agent filled a saved login; $1 is the username, $2 the site">Signed in as <ph name="ARG1">$1<ex>1</ex></ph> on <ph name="ARG2">$2<ex>2</ex></ph></message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_WAITING_UNLOCK" desc="Trace line when a task is paused until the user unlocks agent sign-in; $1 is the site">Waiting for you: unlock saved passwords to let the agent sign in to <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_WAITING_VERIFY" desc="Trace line when a task is paused for a one-time code, passkey or CAPTCHA the agent must not answer; $1 is the site">Waiting for you: finish the verification on <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_REFUSED" desc="Trace line when agent sign-in is refused by policy or by the per-site list; $1 is the site">Did not sign in to <ph name="ARG1">$1<ex>1</ex></ph>: your settings do not allow it</message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_NO_LOGIN" desc="Trace line when the password manager has no login for the site; $1 is the site">No saved login for <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_SEVERAL" desc="Trace line when more than one account matches; $1 is the site">Several saved logins for <ph name="ARG1">$1<ex>1</ex></ph>; asked which one to use</message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_NO_FORM" desc="Trace line when the page has no fillable sign-in form; $1 is the site">No sign-in form on <ph name="ARG1">$1<ex>1</ex></ph> to fill</message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_FAILED" desc="Trace line when filling failed for another reason; $1 is the site">Could not sign in on <ph name="ARG1">$1<ex>1</ex></ph></message>
      <message name="IDS_REDROB_TASK_CREDENTIAL_RESUMED" desc="Trace line when the user resumes a task that waited for them; $1 is the site">Continuing after you finished on <ph name="ARG1">$1<ex>1</ex></ph></message>
    </messages>
  </release>
</grit>
