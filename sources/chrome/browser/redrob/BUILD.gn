source_set("sidecar") {
  sources = [
    "agent_service_factories.cc",
    "agent_service_factories.h",
    "agent_tabs.cc",
    "agent_tabs.h",
    "memory_store.cc",
    "memory_store.h",
    "model_store.cc",
    "model_store.h",
    "oauth_flow.cc",
    "oauth_flow.h",
    "file_tools.cc",
    "file_tools.h",
    "page_tools.cc",
    "page_tools.h",
    "redrob_fonts.cc",
    "redrob_fonts.h",
    "redrob_prefs.cc",
    "redrob_prefs.h",
    "routine_store.cc",
    "routine_store.h",
    "rpc_server.cc",
    "rpc_server.h",
    "sidecar_client.cc",
    "sidecar_client.h",
    "task_store.cc",
    "task_store.h",
    "task_store_factory.cc",
    "task_store_factory.h",
  ]
  public_deps = [
    "//chrome/browser/ui/webui/redrob:mojo_bindings",
    "//components/keyed_service/core",
    "//services/network/public/cpp",
  ]
  deps = [
    # The task failure messages come from the dictionary rather than being written in this code, so this
    # target needs the generated strings and the loader that reads them.
    "//chrome/browser/redrob/resources:redrob_strings",
    "//ui/base",
  ]

  # Not on macOS: there the font travels as bundle_data inside the framework, and building the copy as well would
  # leave a file in the build root that nothing reads and nothing ships.
  if (!is_mac) {
    deps += [ ":ui_font" ]
  }

  deps += [
    "//base",
    # model_store.cc and routine_store.cc report failures to the settings page, so they read the
    # product's own strings rather than carrying English literals. The grit header is generated, so the
    # dependency is what makes it exist at all.
    "//chrome/browser/redrob/resources:redrob_strings",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/thumbnails",
    "//chrome/browser:browser_process",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/pref_registry",
    "//components/prefs",
    "//components/tab_groups",
    "//content/public/browser",
    "//ui/accessibility",
    "//ui/base",
    "//crypto",
    "//net",
    "//net/traffic_annotation",
    "//url",
  ]
}

# The UI typeface, beside the executable.
#
# A copy target rather than a resource-pack entry: the platform font systems all take a PATH, so a font that
# only exists as bytes inside a .pak cannot be registered without standing up a font manager of our own. See
# redrob_fonts.cc.
#
# The same face the WebUI bundles, as a plain TTF rather than the woff2 those use -- Skia's FreeType backend
# cannot open a woff2 container, and the WebUI cannot use a bare TTF without paying for the compression it
# would otherwise get. So the two forms coexist deliberately, from one upstream file.
# Linux and Windows: beside the executable, which is where DIR_MODULE points on both.
copy("ui_font") {
  sources = [ "fonts/PretendardVariable.ttf" ]
  outputs = [ "$root_out_dir/fonts/{{source_file_part}}" ]
}

# macOS needs the same file in a different place, and a copy into the build root does not reach it.
#
# DIR_MODULE for the browser process on macOS is the versioned framework directory inside the .app, so a font in
# $root_out_dir is not merely in the wrong folder -- it is outside the bundle the running binary can see, and it
# does not get shipped either. bundle_data is how a file becomes part of a framework, and the framework target has
# to depend on it; a bundle_data nobody depends on builds fine and copies nothing, which is the failure mode to
# watch for when this is first built on a mac.
if (is_mac) {
  bundle_data("ui_font_bundle_data") {
    sources = [ "fonts/PretendardVariable.ttf" ]
    outputs = [ "{{bundle_resources_dir}}/fonts/{{source_file_part}}" ]
  }
}
