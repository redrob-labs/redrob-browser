diff --git a/chrome/browser/ui/webui/settings/settings_ui.cc b/chrome/browser/ui/webui/settings/settings_ui.cc
index 42854fe44420c..3e79b35a8d783 100644
--- a/chrome/browser/ui/webui/settings/settings_ui.cc
+++ b/chrome/browser/ui/webui/settings/settings_ui.cc
@@ -658,6 +658,30 @@ SettingsUI::SettingsUI(content::WebUI* web_ui)
   html_source->AddBoolean("showAiPageAiFeatureSection",
                           show_ai_features_section);
 
+  // Redrob: the whole "AI in <brand>" settings surface is OFF, unconditionally.
+  //
+  // It is upstream's page for GOOGLE's AI features, and brand substitution made every one of them read as
+  // ours. Measured in a built binary before this: chrome://settings carried an "AI in Redrob" section whose
+  // rows were AI history search, AI suggestions, "Skills in Redrob", "Indigo -- Manage your Indigo data", and
+  // "Google 검색 AI 모드 및 연결된 앱" offering to connect Google Drive and Workspace. This product ships none
+  // of them.
+  //
+  // The disqualifying part is not the advertising, it is the disclosure above the rows. It stated, under our
+  // name, that "관련 데이터가 Google로 전송됩니다" beside a Google logo, and then in English that "Data sent to
+  // Google may be seen by human reviewers to improve Redrob AI's technology". Both are FALSE here: this
+  // browser's agent talks to whichever provider the user configured -- see sidecar_client.cc, which says the
+  // request goes to that provider "not to Google and not to Redrob" -- and no Google reviewer sees any of it.
+  // A privacy claim that is wrong in the user's favour is still a lie, and this one is wrong against them.
+  //
+  // Set after the calls above rather than by rewriting each condition, so an AI boolean added upstream in a
+  // later rebase lands ABOVE this block and is still overridden. Our own agent settings live at
+  // chrome://redrob-settings, which is where a Redrob AI control belongs.
+  html_source->AddBoolean("showAiPage", false);
+  html_source->AddBoolean("showAiPageAiFeatureSection", false);
+  html_source->AddBoolean("showGlicSettings", false);
+  html_source->AddBoolean("enableAiModeSearchSetting", false);
+  html_source->AddBoolean("showOnDeviceAiSettings", false);
+
   html_source->AddBoolean("replaceSyncPromosWithSignInPromos",
                           syncer::IsReplaceSyncPromosWithSignInPromosEnabled());
 
@@ -890,14 +914,14 @@ void SettingsUI::UpdateShowGlicState() {
   // page.
   Profile* profile = Profile::FromWebUI(web_ui());
   auto enablement = glic::GlicEnabling::EnablementForProfile(profile);
-  const bool show_glic = enablement.ShouldShowSettingsPage();
+  // ShouldShowSettingsPage() is deliberately not read: this browser never shows that page.
 
   base::DictValue update;
-  update.Set("showGlicSettings", show_glic);
+  // Redrob: stays false, matching the constructor's unconditional suppression of the AI settings surface --
+  // see the block there for why. Without this, accepting Glic's own first-run would push showGlicSettings and
+  // showAiPage back to true at runtime and the page would reappear in a shipped build.
+  update.Set("showGlicSettings", false);
   update.Set("glicDisallowedByAdmin", enablement.DisallowedByAdmin());
-  if (show_glic) {
-    update.Set("showAiPage", true);
-  }
 
   content::WebUIDataSource::Update(
       web_ui()->GetWebContents()->GetBrowserContext(),
