@@ -613,6 +614,21 @@ StartupBrowserCreatorImpl::DetermineStartupTabs(
     bool is_post_crash_launch,
     bool promotions_enabled,
     bool whats_new_enabled) {
+  // `--redrob-task="..."` wins over everything else this launch would have opened: someone who
+  // typed a task in a terminal is asking for that task, not for their session to be restored
+  // around it. The prompt travels in the URL and the surface starts it, which keeps one
+  // StartTask path -- with its bounds and its permission gate -- rather than a second one here.
+  if (command_line_->HasSwitch(switches::kRedrobTask)) {
+    const std::string prompt =
+        command_line_->GetSwitchValueASCII(switches::kRedrobTask);
+    if (!prompt.empty()) {
+      return {StartupTabs({StartupTab(GURL(std::string(chrome::kChromeUIRedrobURL) +
+                                           "?ask=" +
+                                           base::EscapeQueryParamValue(prompt, false)))}),
+              LaunchResult::kWithGivenUrls};
+    }
+  }
+
