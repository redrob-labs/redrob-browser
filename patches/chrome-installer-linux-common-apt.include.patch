diff --git a/chrome/installer/linux/common/apt.include b/chrome/installer/linux/common/apt.include
index b3368c18c9b0d..b6af8c76975bd 100644
--- a/chrome/installer/linux/common/apt.include
+++ b/chrome/installer/linux/common/apt.include
@@ -19,6 +19,22 @@ find_apt_sources() {
 # Install the repository/package signing keys. The key cannot be part of the
 # package since it's still needed if the package is removed but not purged.
 install_key() {
+  # Redrob: an absent key means write NOTHING, not write nothing to a file.
+  #
+  # Upstream reaches here unconditionally because upstream always has a key. With PGP_KEY_DATA empty the
+  # body below is silent rather than failing -- `echo "" | base64 -d` exits 0 and produces zero bytes -- so
+  # a fork with no key still created /usr/share/keyrings and left an empty keyring on every machine that
+  # installed the package. Nothing breaks today, because install_deb822_sources refuses to add a source
+  # that would reference it. The problem is what that file claims: a keyring exists, so the first thing to
+  # add a sources file by hand or by a later version gets a signature failure instead of a channel that is
+  # cleanly and visibly off.
+  #
+  # Guarded in the function rather than at the three call sites -- debian/postinst, debian/postinst_repo
+  # and repo.cron -- because a guard per call site is a guard someone will add two of.
+  if [ -z "$PGP_KEY_DATA" ]; then
+    return 0
+  fi
+
   if [ ! -e /usr/share/keyrings ]; then
     mkdir -p /usr/share/keyrings
     chmod 755 /usr/share/keyrings
@@ -69,7 +85,7 @@ gen_sources_content() {
 # This file will not be recreated if removed.
 X-Repolib-Name: @@MENUNAME
 Types: deb
-URIs: https://dl.google.com/linux/chrome-@@channel/deb/
+URIs: @@repo_uri
 Suites: stable
 Components: main
 Architectures: @@architecture
@@ -77,7 +93,8 @@ Signed-By: $GPG_FILE
 EOF
 }
 
-# Add the Google repository to the apt sources. The sources cannot be part of
+# Add OUR repository to the apt sources -- see @@repo_uri, derived in installer.py from the same
+# string as REPOCONFIG. The sources cannot be part of
 # the package since it's still needed if the package is removed but not purged.
 create_sources_lists() {
   find_apt_sources
@@ -104,6 +121,20 @@ clean_sources_lists() {
 }
 
 install_deb822_sources() {
+  # Redrob: refuse rather than configure a repository we cannot verify.
+  #
+  # Upstream reaches here unconditionally because upstream always has both halves -- Chrome's repository URL and
+  # Chrome's signing key. A fork that inherited those and left them unset would either point apt at somebody
+  # else's repository or add a source with no keyring at all. No auto-update is a documented gap; a foreign
+  # repository on a user's machine is a defect, so the absence of either value turns this off entirely.
+  #
+  # Both are turned on together, by construction: scripts/update_signing_key.py fills PGP_KEY_DATA, and
+  # REPOCONFIG comes from the packaging. Neither is useful without the other.
+  if [ -z "$REPOCONFIG" ] || [ -z "$PGP_KEY_DATA" ]; then
+    echo "Redrob: no signed update channel is configured for this build, so no apt source was added." >&2
+    return 0
+  fi
+
   find_apt_sources
   LEGACY_LIST="$APT_SOURCESDIR/@@PACKAGE.list"
 
