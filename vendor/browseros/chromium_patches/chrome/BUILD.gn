diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 8a60d7061bbfb..cb2c93b9d9f7f 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -15,7 +15,9 @@ import("//build/config/win/console_app.gni")
 import("//build/config/win/manifest.gni")
 import("//build/private_code_test/private_code_test.gni")
 import("//build/toolchain/toolchain.gni")
+import("//chrome/browser/browseros/buildflags.gni")
 import("//chrome/browser/buildflags.gni")
+import("//chrome/browser/sparkle_buildflags.gni")
 import("//chrome/chrome_paks.gni")
 import("//chrome/common/features.gni")
 import("//chrome/process_version_rc_template.gni")
@@ -87,12 +89,12 @@ if (is_win) {
     # initialexe/ is used so that the we can reorder imports and write back to
     # the final destination at $root_out_dir/.
     inputs = [
-      "$root_out_dir/initialexe/chrome.exe",
-      "$root_out_dir/initialexe/chrome.exe.pdb",
+      "$root_out_dir/initialexe/redrob-browser.exe",
+      "$root_out_dir/initialexe/redrob-browser.exe.pdb",
     ]
     outputs = [
-      "$root_out_dir/chrome.exe",
-      "$root_out_dir/chrome.exe.pdb",
+      "$root_out_dir/redrob-browser.exe",
+      "$root_out_dir/redrob-browser.exe.pdb",
     ]
     args = [
       "-i",
@@ -150,7 +152,8 @@ if (!is_android && !is_mac) {
   }
 
   if (is_win) {
-    _chrome_output_name = "initialexe/chrome"
+    # Redrob: the Windows executable is redrob-browser.exe.
+    _chrome_output_name = "initialexe/redrob-browser"
   } else {
     _chrome_output_name = "chrome"
   }
@@ -381,6 +384,8 @@ if (!is_android && !is_mac) {
     }
 
     data_deps += [
+      "//chrome/browser/browseros/bundled_extensions",
+      "//chrome/browser/browseros/server:browseros_server_resources",
       "//chrome/browser/resources/media/mei_preload:component",
       "//chrome/browser/web_applications/isolated_web_apps/key_distribution/preload:component",
       "//components/privacy_sandbox/privacy_sandbox_attestations/preload:component",
@@ -538,6 +543,7 @@ if (is_win) {
       "CHROMIUM_BUNDLE_ID=$chrome_mac_bundle_id",
       "CHROMIUM_SHORT_NAME=$chrome_product_short_name",
       "CHROMIUM_CREATOR=$chrome_mac_creator_code",
+      "BROWSEROS_PRODUCT_DIR_NAME=$browseros_product_dir_name",
     ]
 
     sources = [
@@ -556,6 +562,7 @@ if (is_win) {
       "//base/allocator:early_zone_registration_apple",
       "//build:branding_buildflags",
       "//build/config/compiler:compiler_buildflags",
+      "//chrome/browser/browseros/server:browseros_server_resources",
       "//chrome/common:buildflags",
       "//chrome/common:version_header",
     ]
@@ -1322,6 +1329,7 @@ if (is_win) {
       "//chrome/browser:chrome_process_singleton",
       "//chrome/browser:process_singleton",
       "//chrome/browser:startup_data",
+      "//chrome/browser/browseros/core",
       "//chrome/browser/lifetime",
       "//chrome/browser/mac",
       "//chrome/common:buildflags",
@@ -1381,6 +1389,11 @@ if (is_win) {
     public_deps = [ ":chrome_dll" ]
 
     bundle_deps = [
+      # Redrob: the UI font, which has to be INSIDE the framework. DIR_MODULE for the browser process on macOS is
+      # the versioned framework directory, so a font copied to the build root is both unreadable at runtime and
+      # unshipped. A bundle_data that no bundle depends on builds green and copies nothing, so this line is the
+      # one that makes the target real.
+      "//chrome/browser/redrob:ui_font_bundle_data",
       ":aperitif_library",
       ":chrome_framework_helpers",
       ":chrome_framework_resources",
@@ -1395,6 +1408,9 @@ if (is_win) {
     if (is_chrome_branded) {
       bundle_deps += [ ":chromecompaneros_bundle_data" ]
     }
+
+    # Bundle the first-run extensions in the framework resource directory.
+    bundle_deps += [ "//chrome/browser/browseros/bundled_extensions" ]
     if (!use_static_angle) {
       bundle_deps += [ ":angle_binaries" ]
     }
@@ -1405,6 +1421,14 @@ if (is_win) {
       bundle_deps += [ ":chrome_renderer_library" ]
     }
 
+    # Sparkle lives inside this framework; expose its directory through the
+    # versioned bundle and resolve it relative to the framework binary.
+    if (enable_sparkle) {
+      bundle_deps += [ "//third_party/sparkle:sparkle_framework_bundle" ]
+      configs += [ "//third_party/sparkle:sparkle_link_framework" ]
+      framework_contents += [ "Frameworks" ]
+    }
+
     configs += [ ":chrome_dll_symbol_order" ]
     if (!is_component_build && !using_sanitizer) {
       configs += [ ":chrome_dll_symbol_exports" ]
@@ -2070,6 +2094,11 @@ if (enable_separate_renderer_binary) {
     "//content/public/app",
     "//v8",
   ]
+  if (!is_win) {
+    # These renderer targets compile the crash reporter client. Depend only on
+    # its BrowserOS constants, keeping the browser implementation out.
+    _chrome_renderer_deps += [ "//chrome/browser/browseros/core" ]
+  }
   if (is_win || is_linux || is_chromeos || is_mac) {
     _chrome_renderer_deps += [ "//components/webapps/isolated_web_apps:scheme" ]
   }
