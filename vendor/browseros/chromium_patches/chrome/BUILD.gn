diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 8a60d7061bbfb..c05386759b2bd 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -87,12 +87,12 @@ if (is_win) {
     # initialexe/ is used so that the we can reorder imports and write back to
     # the final destination at $root_out_dir/.
     inputs = [
-      "$root_out_dir/initialexe/chrome.exe",
-      "$root_out_dir/initialexe/chrome.exe.pdb",
+      "$root_out_dir/initialexe/redrob-browser.exe",
+      "$root_out_dir/initialexe/redrob-browser.exe.pdb",
     ]
     outputs = [
-      "$root_out_dir/chrome.exe",
-      "$root_out_dir/chrome.exe.pdb",
+      "$root_out_dir/redrob-browser.exe",
+      "$root_out_dir/redrob-browser.exe.pdb",
     ]
     args = [
       "-i",
@@ -150,7 +150,8 @@ if (!is_android && !is_mac) {
   }
 
   if (is_win) {
-    _chrome_output_name = "initialexe/chrome"
+    # Redrob: the Windows executable is redrob-browser.exe.
+    _chrome_output_name = "initialexe/redrob-browser"
   } else {
     _chrome_output_name = "chrome"
   }
@@ -1381,6 +1382,11 @@ if (is_win) {
     public_deps = [ ":chrome_dll" ]
 
     bundle_deps = [
+      # Redrob: the UI font, which has to be INSIDE the framework. DIR_MODULE for the browser process on macOS is
+      # the versioned framework directory, so a font copied to the build root is both unreadable at runtime and
+      # unshipped. A bundle_data that no bundle depends on builds green and copies nothing, so this line is the
+      # one that makes the target real.
+      "//chrome/browser/redrob:ui_font_bundle_data",
       ":aperitif_library",
       ":chrome_framework_helpers",
       ":chrome_framework_resources",
