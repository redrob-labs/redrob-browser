# The flavour we would ship: what upstream calls an official build.
#
# LTO and PGO are the difference between "our fork is slower than Chrome" and not, so they belong here
# even though they cost hours. Do not use this for a first build or for iteration.
is_debug = false
is_official_build = true
symbol_level = 1
blink_symbol_level = 0
is_component_build = false
use_sysroot = true
enable_nacl = false

proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Official builds want a PGO profile for the pinned release; the checkout's hooks fetch it. If that
# download is unavailable for a given pin, set chrome_pgo_phase = 0 rather than dropping the flavour.
treat_warnings_as_errors = false
