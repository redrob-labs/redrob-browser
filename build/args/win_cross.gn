# Windows x64, CROSS-built on a Linux host.
#
# The same build as build/args/windows.gn -- read that file for why each value is what it is -- with the target
# named explicitly, because a native flavour leaves target_os to the host and this host is Linux. The PC build
# that this replaces ran on a 10-core laptop at base clock: ~10 objects a minute, measured. A Linux build host
# with 32 cores does the same work several times faster, and it is the host the Linux and macOS releases are
# already built on.
#
# What the host needs, once (docs/WINDOWS.md "Cross-building on Linux"):
#   * `target_os = ["win"]` in chromium/.gclient, then `gclient sync` + `gclient runhooks`
#   * a packaged MSVC toolchain zip (depot_tools/win_toolchain/package_from_installed.py, run on a Windows
#     machine with the matching VS and SDK), served to the hook through DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL and
#     mapped onto Chromium's pinned hash with GYP_MSVS_HASH_<pinned>=<ours>
#   * a case-insensitive view of that toolchain: ciopfs where FUSE is allowed, otherwise lowercase aliases
target_os = "win"
target_cpu = "x64"

is_debug = false
symbol_level = 0
blink_symbol_level = 0
is_component_build = false
enable_nacl = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"
treat_warnings_as_errors = false
browseros_package_all_server_resources = false
