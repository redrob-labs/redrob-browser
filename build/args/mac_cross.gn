# macOS arm64, CROSS-built on a Linux host.
#
# build/args/mac.gn is the flavour for a build ON a Mac; this one names the target explicitly, because a
# native flavour leaves target_os to the host and this host is Linux. It is the build the 0.1.6 macOS release
# came from -- that build ran from a hand-written args.gn, and the hand-written file is how the next defect
# got in.
target_os = "mac"
target_cpu = "arm64"

is_debug = false
symbol_level = 0
blink_symbol_level = 0
is_component_build = false
enable_nacl = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"
treat_warnings_as_errors = false

# Clang modules and the autogenerated module maps assume Xcode's SDK layout on the build host. A Linux host
# reaches the SDK through the hermetic toolchain instead, and module builds fail there.
use_clang_modules = false
use_autogenerated_modules = false
use_system_xcode = false

# Package only the agent server this product launches -- the same line every other flavour carries. The
# hand-written 0.1.6 args.gn lacked it, so the ported default (true) packaged the BrowserClaw server too,
# and vendor/ only has a Linux x86-64 build of it: the signed 0.1.6 mac app carried a Linux ELF under
# Contents/Resources/BrowserClawServer that nothing on macOS can run and Redrob never launches.
browseros_package_all_server_resources = false
