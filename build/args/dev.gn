# The flavour to use for a first build and for day-to-day work.
#
# Not an official build: `is_official_build` turns on LTO and wants a PGO profile, which roughly doubles
# a wall clock already measured in hours. Symbols are off for the same reason -- a fork's first question
# is "does it build and launch", and that question does not need a debugger.
is_debug = false
symbol_level = 0
blink_symbol_level = 0

# One binary rather than a few hundred shared objects. A component build links faster on iteration but
# produces something awkward to run and ship, and we want `run` to launch a real browser.
is_component_build = false

# Chromium's own sysroot supplies the C libraries, so nothing has to be installed on the host. This is
# what makes a home-only build possible here.
use_sysroot = true

# Off: it is a large chunk of build for a plugin technology we do not ship.
enable_nacl = false

# The media story the product needs. `proprietary_codecs` plus Chrome's ffmpeg branding is what makes
# H.264 and AAC play, which is most of the video on the sites we care about. Widevine is the DRM half
# and is a licensing question before it is a build flag -- see docs/BUILD.md.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# A fork does not get to treat upstream's warnings as its own errors, and a first build should not fail
# on one.
treat_warnings_as_errors = false
