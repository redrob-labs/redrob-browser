# macOS, for a first build rather than a shipped one.
#
# The point of this flavour is to answer "does the fork compile and launch on macOS", which nothing has ever
# answered. So it is deliberately the DEV shape: no LTO, no PGO, symbols off. That is not thrift -- it is what
# makes the question answerable on hardware that exists.
#
# The Linux release build measured a peak RSS of 19.9 GB across the LTO link. A GitHub-hosted macOS runner has
# 14 GB, so a release-flavour mac build would be killed by the linker rather than fail for a reason worth reading.
# The Linux DEV build peaked at 7.1 GB, which fits with room to spare. A shipped mac build needs a self-hosted
# machine; this one needs a runner.
is_debug = false
symbol_level = 0
blink_symbol_level = 0

# One binary rather than a few hundred dylibs, for the same reason as the Linux flavours: a component build links
# faster and produces something awkward to launch, and launching it is the whole test.
is_component_build = false

# x86-64 explicitly. An arm64 host would otherwise pick its own architecture, and a universal binary is a
# lipo of two builds -- a later problem, and one that doubles the wall clock of the first one.
target_cpu = "x64"

# Off: a large chunk of build for a plugin technology we do not ship.
enable_nacl = false

# The media story the product needs. See docs/BUILD.md -- Widevine is a licensing question before it is a flag.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# A fork does not get to treat upstream's warnings as its own errors, and a FIRST build on a new platform will
# have plenty of them.
treat_warnings_as_errors = false

# Package only the agent server this product launches. The ported tree defaults to packaging the
# BrowserClaw server too, for a product branch Redrob cannot reach; that server is staged by hand and has
# no Windows build, so packaging it made every fresh checkout depend on a file nobody produces.
browseros_package_all_server_resources = false
